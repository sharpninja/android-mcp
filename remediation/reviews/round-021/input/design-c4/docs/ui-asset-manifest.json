        {
          "screen_id": "SCR07",
          "state_id": "SCR07.S4",
          "control_id": "SCR07.C02",
          "actor": "Owner",
          "action": "Disconnect/cancel",
          "result": "Watch socket closes; pressed state released",
          "alternate": "Uncertain click is not blindly replayed"
        }
      ],
      "boundary": "Existing ARC v1 bytes remain unchanged. Target operation controls are capability/policy gated; protected local owner surfaces are never an ARC root."
    },
