  "storyboards": [
    {
      "id": "STB01",
      "title": "Inspect an agent session and stop a callback",
      "steps": [
        {
          "screen_id": "SCR04",
          "state_id": "SCR04.S0",
          "control_id": "SCR04.C01",
          "actor": "Owner",
          "action": "Inspect group summary",
          "result": "Selected client/session shown",
          "alternate": "Denied grant remains visible; no UI activation"
        },
        {
          "screen_id": "SCR05",
          "state_id": "SCR05.S0",
          "control_id": "SCR05.C01",
          "actor": "Owner",
          "action": "Inspect subscription status",
          "result": "Agent registered via its own MCP session",
          "alternate": "No registration: SCR05.S1; never impersonate client"
        },
        {
          "screen_id": "SCR09",
          "state_id": "SCR09.S0",
          "control_id": "SCR09.C01",
          "actor": "Owner",
          "action": "Approve exact admin cancellation",
          "result": "Nonce/revision-bound cancellation admitted",
          "alternate": "Dismiss/expiry: no cancellation command"
        },
        {
          "screen_id": "SCR05",
          "state_id": "SCR05.S4",
          "control_id": "SCR05.C01",
          "actor": "Owner",
          "action": "Inspect closed delivery",
          "result": "Cleanup confirmed or explicitly unknown",
          "alternate": "Backend death: payload hidden; retain cleanup status"
        }
      ],
      "boundary": "The agent owns MCP discovery/activation/registration/resource reads. The owner UI observes scoped metadata; administrative cancellation uses protected owner authority, not client impersonation."
    },
    {
      "id": "STB02",
