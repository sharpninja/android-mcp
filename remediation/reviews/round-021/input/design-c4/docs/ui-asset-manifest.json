        {
          "screen_id": "SCR08",
          "state_id": "SCR08.S0",
          "control_id": "SCR08.C03",
          "actor": "Owner",
          "action": "Navigate to dashboard",
          "result": "SCR01 shows independent MCP/ADB/device-view health; grants unchanged",
