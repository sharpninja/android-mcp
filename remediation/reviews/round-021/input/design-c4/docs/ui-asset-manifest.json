        {
          "screen_id": "SCR08",
          "state_id": "SCR08.S0",
          "control_id": "SCR08.C02",
          "actor": "Owner",
          "action": "Inspect verified paired endpoint status",
          "result": "Connected or Paired offline is distinct from MCP listener health",
