        {
          "screen_id": "SCR07",
          "state_id": "SCR07.S4",
          "control_id": "SCR07.C01",
          "actor": "Owner",
          "action": "Observe capabilities/frame",
          "result": "Verified target generation and DIP scale",
          "alternate": "Protected/unknown root: no action"
