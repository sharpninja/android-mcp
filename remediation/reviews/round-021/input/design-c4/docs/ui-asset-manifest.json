        },
        {
          "screen_id": "SCR09",
          "state_id": "SCR09.S0",
          "control_id": "SCR09.C01",
          "actor": "Owner",
          "action": "Authenticate exact pairing/connect command",
          "result": "Bounded native pairing uses the owner-provided Android pairing material",
