        {
          "screen_id": "SCR07",
          "state_id": "SCR07.S4",
          "control_id": "SCR07.C04",
          "actor": "Owner",
          "action": "Request admitted control",
          "result": "Exact target policy checked before dispatch",
          "alternate": "OK envelope plus failed CommandResult is still denied"
