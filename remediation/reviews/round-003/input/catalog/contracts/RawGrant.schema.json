{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:android-binding-catalog:1.1.0:RawGrant",
  "type": "object",
  "properties": {
    "connection_id": {"type":"string","minLength":1},
    "descriptor": {"type":"string","minLength":1},
    "code_min": {"type":"integer","minimum":0,"maximum":4294967295},
    "code_max": {"type":"integer","minimum":0,"maximum":4294967295},
    "flags_mask": {"type":"integer","minimum":0,"maximum":4294967295},
    "contract_hash": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "effect": {"enum":["deny","ask","allow"]},
    "allowed_targets": {"type":"array","uniqueItems":true,"items":{"type":"string"}},
    "allowed_handles": {"type":"array","uniqueItems":true,"items":{"type":"string"}},
    "allowed_displays": {"type":"array","uniqueItems":true,"items":{"type":"integer","minimum":0}},
    "max_items": {"type":"integer","minimum":0}
  },
  "required":["connection_id","descriptor","code_min","code_max","flags_mask","contract_hash","effect","allowed_targets","allowed_handles","allowed_displays","max_items"],
  "additionalProperties": false,
  "description":"Application semantic validation additionally requires code_max >= code_min. Empty allowed sets deny; no wildcard or inferred binding grant."
}
