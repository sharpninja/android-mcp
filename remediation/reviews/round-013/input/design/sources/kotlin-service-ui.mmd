flowchart TD
  APK[One Kotlin Android APK and UID] --> Service[Started foreground BridgeService]
  APK --> UI[Compose Activity and ViewModel]
  UI --> Facade[Unexported bounded local Binder facade]
  Facade --> Owner[Owner auth and command admission]
  Owner --> Service
  Client[Authenticated MCP clients] --> Service
  Service --> Policy[Canonical policy and revision gate]
  Policy --> Store[Service owned SQLite transactions]
  Policy --> Runtime[Resolver Binder ADB callbacks and groups]
  Service --> Status[Readiness StateFlow and notification]
  Status --> UI
  Runtime --> External[Optional external protocol targets]
