{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:android-binding-catalog:2.1.0:DeviceResolution",
  "$ref": "#/$defs/InventoryEntity",
  "$defs": {
    "PlatformRange": {
      "type": "object",
      "properties": {
        "introduced": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          },
          "minItems": 2,
          "maxItems": 2
        },
        "removed": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2147483647
              },
              "minItems": 2,
              "maxItems": 2
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "introduced",
        "removed"
      ],
      "additionalProperties": false
    },
    "ModuleRange": {
      "type": "object",
      "properties": {
        "introduced": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "maxLength": 19
        },
        "removed": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$",
              "maxLength": 19
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "introduced",
        "removed"
      ],
      "additionalProperties": false
    },
    "InterfaceConstraint": {
      "type": "object",
      "properties": {
        "descriptor": {
          "type": "string",
          "minLength": 1
        },
        "minimum_version": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647
            },
            {
              "type": "null"
            }
          ]
        },
        "accepted_hashes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      },
      "required": [
        "descriptor",
        "minimum_version",
        "accepted_hashes"
      ],
      "additionalProperties": false
    },
    "Clause": {
      "type": "object",
      "properties": {
        "platform": {
          "$ref": "#/$defs/PlatformRange"
        },
        "extensions": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          }
        },
        "modules": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/ModuleRange"
          }
        },
        "oem": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "build_fingerprints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "interface": {
          "$ref": "#/$defs/InterfaceConstraint"
        },
        "unknown_reason": {
          "type": "string",
          "minLength": 1
        },
        "platform_point": {
          "type": "array",
          "prefixItems": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        }
      },
      "required": [],
      "additionalProperties": false,
      "minProperties": 1
    },
    "Rule": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "alternatives": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Clause"
              },
              "minItems": 1
            },
            "evidence_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            }
          },
          "required": [
            "alternatives",
            "evidence_ids"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "unknown_reason": {
              "type": "string",
              "minLength": 1
            },
            "x-raw": {}
          },
          "required": [
            "unknown_reason"
          ],
          "additionalProperties": false
        }
      ]
    },
    "ModuleFact": {
      "type": "object",
      "properties": {
        "state": {
          "enum": [
            "present",
            "absent",
            "unknown"
          ]
        },
        "version": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$",
              "maxLength": 19
            },
            {
              "type": "null"
            }
          ]
        },
        "authoritative": {
          "type": "boolean"
        }
      },
      "required": [
        "state",
        "version",
        "authoritative"
      ],
      "additionalProperties": false
    },
    "InterfaceFact": {
      "type": "object",
      "properties": {
        "state": {
          "enum": [
            "reachable",
            "absent",
            "denied",
            "unreachable",
            "unsupported",
            "unknown"
          ]
        },
        "version": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647
            },
            {
              "type": "null"
            }
          ]
        },
        "hash": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "authoritative": {
          "type": "boolean"
        }
      },
      "required": [
        "state",
        "version",
        "hash",
        "authoritative"
      ],
      "additionalProperties": false
    },
    "Facts": {
      "type": "object",
      "properties": {
        "profile_id": {
          "type": "string",
          "minLength": 1
        },
        "target_key": {
          "type": "string",
          "minLength": 1
        },
        "android_user_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "backend_instance_id": {
          "type": "string",
          "minLength": 1
        },
        "device_instance_id": {
          "type": "string",
          "minLength": 1
        },
        "identity_verified": {
          "type": "boolean"
        },
        "capability_epoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "observed_at": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "format": "date-time"
        },
        "platform": {
          "type": "object",
          "properties": {
            "major": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 2147483647
                },
                {
                  "type": "null"
                }
              ]
            },
            "minor": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 2147483647
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "major",
            "minor"
          ],
          "additionalProperties": false
        },
        "extensions": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 2147483647
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "modules": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/ModuleFact"
          }
        },
        "interfaces": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/InterfaceFact"
          }
        },
        "oem": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "build_fingerprint": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      },
      "required": [
        "profile_id",
        "target_key",
        "android_user_id",
        "backend_instance_id",
        "device_instance_id",
        "identity_verified",
        "capability_epoch",
        "observed_at",
        "platform",
        "extensions",
        "modules",
        "interfaces",
        "oem",
        "build_fingerprint",
        "evidence_ids"
      ],
      "additionalProperties": false
    },
    "Dependency": {
      "type": "object",
      "properties": {
        "entry_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "schema_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "entry_id",
        "schema_hash"
      ],
      "additionalProperties": false
    },
    "Variant": {
      "type": "object",
      "properties": {
        "schema_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "availability": {
          "$ref": "#/$defs/Rule"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Dependency"
          },
          "minItems": 0
        }
      },
      "required": [
        "schema_hash",
        "availability",
        "dependencies"
      ],
      "additionalProperties": false
    },
    "InventoryEntity": {
      "type": "object",
      "properties": {
        "entry_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "entity_kind": {
          "enum": [
            "binding",
            "type",
            "other"
          ]
        },
        "variants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Variant"
          },
          "minItems": 0
        }
      },
      "required": [
        "entry_id",
        "entity_kind",
        "variants"
      ],
      "additionalProperties": false
    },
    "ResolvedEntry": {
      "type": "object",
      "properties": {
        "entry_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "entity_kind": {
          "enum": [
            "binding",
            "type",
            "other"
          ]
        },
        "state": {
          "enum": [
            "available",
            "unavailable",
            "unknown"
          ]
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "schema_hash": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Dependency"
          },
          "minItems": 0
        },
        "graph_digest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "entry_id",
        "entity_kind",
        "state",
        "reason_codes",
        "schema_hash",
        "dependencies",
        "graph_digest"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "available"
              }
            }
          },
          "then": {
            "properties": {
              "schema_hash": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "graph_digest": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      ]
    },
    "Snapshot": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "2.0.0"
        },
        "view_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "facts_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "registry_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "catalog_generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "overlay_generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "capability_epoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "view_generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "inventory_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ResolvedEntry"
          },
          "minItems": 0
        },
        "profile_id": {
          "type": "string",
          "minLength": 1
        },
        "target_key": {
          "type": "string",
          "minLength": 1
        },
        "android_user_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "backend_instance_id": {
          "type": "string",
          "minLength": 1
        },
        "device_instance_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "schema_version",
        "view_id",
        "facts_id",
        "registry_id",
        "catalog_generation",
        "overlay_generation",
        "capability_epoch",
        "view_generation",
        "inventory_count",
        "entries",
        "profile_id",
        "target_key",
        "android_user_id",
        "backend_instance_id",
        "device_instance_id"
      ],
      "additionalProperties": false,
      "deprecated": true,
      "x-publishable": false,
      "x-replaced-by": "urn:android-binding-catalog:3.0.0:DeviceView#/$defs/Snapshot",
      "description": "Historical resolved2 read shape only. Inventory2.1 root is InventoryEntity; only DeviceView3 snapshots may be published."
    },
    "SnapshotResponse": {
      "type": "object",
      "properties": {
        "snapshot": {
          "anyOf": [
            {
              "$ref": "#/$defs/Snapshot"
            },
            {
              "type": "null"
            }
          ]
        },
        "stale": {
          "type": "boolean"
        },
        "capability_epoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "snapshot",
        "stale",
        "capability_epoch",
        "generation"
      ],
      "additionalProperties": false
    },
    "Header": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "2.0.0"
        },
        "view_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "facts_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "registry_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "catalog_generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "overlay_generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "capability_epoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "view_generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "inventory_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "profile_id": {
          "type": "string",
          "minLength": 1
        },
        "target_key": {
          "type": "string",
          "minLength": 1
        },
        "android_user_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "backend_instance_id": {
          "type": "string",
          "minLength": 1
        },
        "device_instance_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "schema_version",
        "view_id",
        "facts_id",
        "registry_id",
        "catalog_generation",
        "overlay_generation",
        "capability_epoch",
        "view_generation",
        "inventory_count",
        "profile_id",
        "target_key",
        "android_user_id",
        "backend_instance_id",
        "device_instance_id"
      ],
      "additionalProperties": false,
      "deprecated": true,
      "x-publishable": false,
      "x-replaced-by": "urn:android-binding-catalog:3.0.0:DeviceView#/$defs/Snapshot",
      "description": "Historical resolved2 read shape only. Inventory2.1 root is InventoryEntity; only DeviceView3 snapshots may be published."
    },
    "StatusResponse": {
      "type": "object",
      "properties": {
        "header": {
          "anyOf": [
            {
              "$ref": "#/$defs/Header"
            },
            {
              "type": "null"
            }
          ]
        },
        "stale": {
          "type": "boolean"
        },
        "capability_epoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "header",
        "stale",
        "capability_epoch",
        "generation"
      ],
      "additionalProperties": false
    },
    "EntryPage": {
      "type": "object",
      "properties": {
        "view_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "view_generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ResolvedEntry"
          },
          "maxItems": 500
        },
        "next_cursor": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "view_id",
        "view_generation",
        "items",
        "next_cursor"
      ],
      "additionalProperties": false
    },
    "RefreshRequest": {
      "type": "object",
      "properties": {
        "profile_id": {
          "type": "string",
          "minLength": 1
        },
        "target_key": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "profile_id",
        "target_key"
      ],
      "additionalProperties": false
    }
  },
  "description": "Catalog inventory2.1 adds explicit point evidence: other versions are unknown, never inferred absent. Historical resolved2 definitions cannot activate as DeviceView3."
}
