<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net10.0-android</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <PackageId>SharpNinja.Avalonia.RemoteControl.Protocol</PackageId>
    <Title>Avalonia Remote Control Protocol</Title>
    <Description>Versioned gRPC and bridge protocol contracts for Avalonia Remote Control.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Protobuf Include="Protos\remote_control.proto" GrpcServices="Both" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Core.Api" />
    <PackageReference Include="Grpc.Tools" PrivateAssets="all" />
  </ItemGroup>
</Project>
