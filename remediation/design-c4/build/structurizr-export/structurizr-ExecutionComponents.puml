rectangle "==Android OS and target apps\n<size:16>[Software System]</size>\n\nFinal OS authority, Binder services, adbd and uninstrumented targets" <<Element-RWxlbWVudA==>> as AndroidOSandtargetapps

rectangle "Android MCP bridge\n<size:16>[Software System]</size>" <<Boundary-QW5kcm9pZCBNQ1AgYnJpZGdl>> {
  rectangle "Android bridge APK\n<size:16>[Container: Kotlin / Jetpack Compose]</size>" <<Boundary-QW5kcm9pZCBicmlkZ2UgQVBL>> {
    rectangle "==McpServer\n<size:16>[Component: Kotlin]</size>\n\nPinned MCP2025-11-25 sessions/resources plus separately negotiated direct-event route" <<Element-RWxlbWVudA==>> as AndroidMCPbridge.AndroidbridgeAPK.McpServer
    rectangle "==AdmissionGate\n<size:16>[Component: Kotlin]</size>\n\nCanonical policy, approvals, epochs and dispatch boundary" <<Element-RWxlbWVudA==>> as AndroidMCPbridge.AndroidbridgeAPK.AdmissionGate
    rectangle "==CatalogRepository\n<size:16>[Component: Kotlin / SQLite]</size>\n\nImmutable imports, local overlays, CAS, full inventory" <<Element-RWxlbWVudA==>> as AndroidMCPbridge.AndroidbridgeAPK.CatalogRepository
    rectangle "==DeviceViewResolver\n<size:16>[Component: Kotlin]</size>\n\nObserved version applicability and coherent binding/type activation" <<Element-RWxlbWVudA==>> as AndroidMCPbridge.AndroidbridgeAPK.DeviceViewResolver
    rectangle "==InvocationPlanner\n<size:16>[Component: Kotlin]</size>\n\nTyped generic/raw dispatch, codecs, Binder, ADB and ARC target adapters" <<Element-RWxlbWVudA==>> as AndroidMCPbridge.AndroidbridgeAPK.InvocationPlanner
    rectangle "==CallbackBroker\n<size:16>[Component: Kotlin]</size>\n\nRegistration, bounded journal, local reply and cleanup obligations" <<Element-RWxlbWVudA==>> as AndroidMCPbridge.AndroidbridgeAPK.CallbackBroker
    rectangle "==AdbPhoneBackend\n<size:16>[Component: Kotlin]</size>\n\nSeparate paired ADB connection manager and on-demand phone operations" <<Element-RWxlbWVudA==>> as AndroidMCPbridge.AndroidbridgeAPK.AdbPhoneBackend
    rectangle "==SqliteStoreCoordinator\n<size:16>[Component: Kotlin / SQLite]</size>\n\nOne serialized writer connection and bounded read-only snapshots" <<Element-RWxlbWVudA==>> as AndroidMCPbridge.AndroidbridgeAPK.SqliteStoreCoordinator
  }

  database "==App-private catalog/configuration\n<size:16>[Container: SQLite]</size>\n\nCatalog snapshots, client/principal mappings, grants/logging configuration, groups/views, journal and audit; secret keys remain in Keystore" <<Element-RWxlbWVudCxEYXRhYmFzZQ==>> as AndroidMCPbridge.Appprivatecatalogconfiguration
}

