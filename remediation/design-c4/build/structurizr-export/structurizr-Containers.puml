@startuml
!include ../../architecture/render-skin.puml
title <size:24>Container View: Android MCP bridge</size>\n<size:24>C4 containers: runtime and offline tooling</size>

set separator none
left to right direction
skinparam ranksep 60
skinparam nodesep 30
hide stereotype

<style>
  root {
    BackgroundColor: #ffffff;
    FontColor: #444444;
  }
  // Element
  .Element-RWxlbWVudA== {
    BackgroundColor: #edf3f8;
    LineColor: #34526b;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #17212b;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Element,Database
  .Element-RWxlbWVudCxEYXRhYmFzZQ== {
    BackgroundColor: #edf3f8;
    LineColor: #34526b;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #17212b;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Element,Person
  .Element-RWxlbWVudCxQZXJzb24= {
    BackgroundColor: #edf3f8;
    LineColor: #34526b;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #17212b;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Relationship
  .Relationship-UmVsYXRpb25zaGlw {
    LineThickness: 2;
    LineStyle: 10-10;
    LineColor: #34526b;
    FontColor: #34526b;
    FontSize: 20;
  }
  // Android MCP bridge
  .Boundary-QW5kcm9pZCBNQ1AgYnJpZGdl {
    BackgroundColor: #ffffff;
    LineColor: #34526b;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #17212b;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
  }
</style>

person "==Local owner\n<size:16>[Person]</size>\n\nAuthenticates protected management commands" <<Element-RWxlbWVudCxQZXJzb24=>> as Localowner
rectangle "==MCP client\n<size:16>[Software System]</size>\n\nConsuming agent owns business decisions and selected context" <<Element-RWxlbWVudA==>> as MCPclient
rectangle "==Compatible ARC client\n<size:16>[Software System]</size>\n\nExisting arc-protobuf-v1 remote-control client" <<Element-RWxlbWVudA==>> as CompatibleARCclient
rectangle "==Compatible external ARC target\n<size:16>[Software System]</size>\n\nOpted-in Avalonia or Kotlin target retaining ARC wire" <<Element-RWxlbWVudA==>> as CompatibleexternalARCtarget
rectangle "==Android OS and target apps\n<size:16>[Software System]</size>\n\nFinal OS authority, Binder services, adbd and uninstrumented targets" <<Element-RWxlbWVudA==>> as AndroidOSandtargetapps
rectangle "==Versioned public sources\n<size:16>[Software System]</size>\n\nSDK, AOSP, permissions, AIDL and protocol evidence; unknown coverage retained" <<Element-RWxlbWVudA==>> as Versionedpublicsources

rectangle "Android MCP bridge\n<size:16>[Software System]</size>" <<Boundary-QW5kcm9pZCBNQ1AgYnJpZGdl>> {
  database "==App-private catalog/configuration\n<size:16>[Container: SQLite]</size>\n\nCatalog snapshots, client/principal mappings, grants/logging configuration, groups/views, journal and audit; secret keys remain in Keystore" <<Element-RWxlbWVudCxEYXRhYmFzZQ==>> as AndroidMCPbridge.Appprivatecatalogconfiguration
  rectangle "==Offline catalog tooling\n<size:16>[Container: Python]</size>\n\nSource acquisition/extraction/schema validation and reference fixtures; no phone operations" <<Element-RWxlbWVudA==>> as AndroidMCPbridge.Offlinecatalogtooling
  rectangle "==Documentation build\n<size:16>[Container: Gradle / Structurizr / Marp]</size>\n\nLocal model validation and Markdown/SVG/storyboard packaging; no deployed app" <<Element-RWxlbWVudA==>> as AndroidMCPbridge.Documentationbuild
  rectangle "==Android bridge APK\n<size:16>[Container: Kotlin / Jetpack Compose]</size>\n\nOne UID and one process in this reference design; Kotlin service owns authoritative state" <<Element-RWxlbWVudA==>> as AndroidMCPbridge.AndroidbridgeAPK
}

Localowner --> AndroidMCPbridge.AndroidbridgeAPK <<Relationship-UmVsYXRpb25zaGlw>> : "Uses local Compose management and protected approvals"
MCPclient --> AndroidMCPbridge.AndroidbridgeAPK <<Relationship-UmVsYXRpb25zaGlw>> : "Bounded discovery/invocation/resource reads\n<size:14>[Authenticated loopback MCP Streamable HTTP2025-11-25]</size>"
CompatibleARCclient --> AndroidMCPbridge.AndroidbridgeAPK <<Relationship-UmVsYXRpb25zaGlw>> : "One request/socket or bounded watch\n<size:14>[arc-protobuf-v1; envelope1.0; authenticated raw loopback TCP]</size>"
AndroidMCPbridge.AndroidbridgeAPK --> CompatibleexternalARCtarget <<Relationship-UmVsYXRpb25zaGlw>> : "First request/response validates pinned profile; no handshake\n<size:14>[ARC raw TCP; signed4byteBE; envelope1.0; loopback]</size>"
AndroidMCPbridge.AndroidbridgeAPK --> AndroidOSandtargetapps <<Relationship-UmVsYXRpb25zaGlw>> : "SDK/Binder and separately paired ADB calls, probes and death signals"
AndroidMCPbridge.AndroidbridgeAPK --> AndroidMCPbridge.Appprivatecatalogconfiguration <<Relationship-UmVsYXRpb25zaGlw>> : "Reads catalog/policy/groups/views; writes overlays/journal/audit via one serialized writer connection\n<size:14>[App-private SQLite]</size>"
AndroidMCPbridge.Offlinecatalogtooling --> AndroidMCPbridge.AndroidbridgeAPK <<Relationship-UmVsYXRpb25zaGlw>> : "Produces portable catalog release; owner selects SAF document; importer verifies hashes/schema and stages atomic activation\n<size:14>[Owner-mediated file import, not network deployment]</size>"
AndroidMCPbridge.Documentationbuild --> Localowner <<Relationship-UmVsYXRpb25zaGlw>> : "Produces editable Markdown, SVGs, local HTML and portable ZIP\n<size:14>[Local files only]</size>"
Versionedpublicsources --> AndroidMCPbridge.Offlinecatalogtooling <<Relationship-UmVsYXRpb25zaGlw>> : "Supplies immutable pinned input evidence"

@enduml