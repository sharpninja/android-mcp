person "==Local owner\n<size:16>[Person]</size>\n\nAuthenticates protected management commands" <<Element-RWxlbWVudCxQZXJzb24=>> as Localowner

rectangle "==Compatible ARC client\n<size:16>[Software System]</size>\n\nExisting arc-protobuf-v1 remote-control client" <<Element-RWxlbWVudA==>> as CompatibleARCclient
rectangle "==Compatible external ARC target\n<size:16>[Software System]</size>\n\nOpted-in Avalonia or Kotlin target retaining ARC wire" <<Element-RWxlbWVudA==>> as CompatibleexternalARCtarget
rectangle "==Android OS and target apps\n<size:16>[Software System]</size>\n\nFinal OS authority, Binder services, adbd and uninstrumented targets" <<Element-RWxlbWVudA==>> as AndroidOSandtargetapps

rectangle "Android MCP bridge\n<size:16>[Software System]</size>" <<Boundary-QW5kcm9pZCBNQ1AgYnJpZGdl>> {
  rectangle "Android bridge APK\n<size:16>[Container: Kotlin / Jetpack Compose]</size>" <<Boundary-QW5kcm9pZCBicmlkZ2UgQVBL>> {
    rectangle "==ClientAuthenticator\n<size:16>[Component: Kotlin / Keystore]</size>\n\nCredential, principal and session ownership" <<Element-RWxlbWVudA==>> as AndroidMCPbridge.AndroidbridgeAPK.ClientAuthenticator
    rectangle "==AdmissionGate\n<size:16>[Component: Kotlin]</size>\n\nCanonical policy, approvals, epochs and dispatch boundary" <<Element-RWxlbWVudA==>> as AndroidMCPbridge.AndroidbridgeAPK.AdmissionGate
    rectangle "==ArcEngine\n<size:16>[Component: Kotlin / protobuf]</size>\n\nProposed Kotlin port preserving pinned ARC wire/profile; no app implementation claimed" <<Element-RWxlbWVudA==>> as AndroidMCPbridge.AndroidbridgeAPK.ArcEngine
    rectangle "==ArcClientAdapter\n<size:16>[Component: Kotlin / protobuf]</size>\n\nController-side session/profile and compatible external-target connection" <<Element-RWxlbWVudA==>> as AndroidMCPbridge.AndroidbridgeAPK.ArcClientAdapter
    rectangle "==Compose management UI\n<size:16>[Component: Kotlin / Compose]</size>\n\nScreen definitions and selected unprotected ComposeTargetAdapter root; management/protected roots excluded" <<Element-RWxlbWVudA==>> as AndroidMCPbridge.AndroidbridgeAPK.ComposemanagementUI
    rectangle "==OwnerCommandFacade\n<size:16>[Component: Kotlin]</size>\n\nProtected owner commands; nonce/revision-bound fresh authentication" <<Element-RWxlbWVudA==>> as AndroidMCPbridge.AndroidbridgeAPK.OwnerCommandFacade
    rectangle "==SessionCommandFacade\n<size:16>[Component: Kotlin]</size>\n\nBounded unexported session commands; server-derived principal and canonical policy" <<Element-RWxlbWVudA==>> as AndroidMCPbridge.AndroidbridgeAPK.SessionCommandFacade
    rectangle "==SqliteStoreCoordinator\n<size:16>[Component: Kotlin / SQLite]</size>\n\nOne serialized writer connection and bounded read-only snapshots" <<Element-RWxlbWVudA==>> as AndroidMCPbridge.AndroidbridgeAPK.SqliteStoreCoordinator
    rectangle "==AuditLogger\n<size:16>[Component: Kotlin]</size>\n\nMandatory audit and configurable per-client payload logging" <<Element-RWxlbWVudA==>> as AndroidMCPbridge.AndroidbridgeAPK.AuditLogger
    rectangle "==BridgeService\n<size:16>[Component: Kotlin Android Service]</size>\n\nForeground lifecycle, boot eligibility and truthful status" <<Element-RWxlbWVudA==>> as AndroidMCPbridge.AndroidbridgeAPK.BridgeService
  }

  database "==App-private catalog/configuration\n<size:16>[Container: SQLite]</size>\n\nCatalog snapshots, client/principal mappings, grants/logging configuration, groups/views, journal and audit; secret keys remain in Keystore" <<Element-RWxlbWVudCxEYXRhYmFzZQ==>> as AndroidMCPbridge.Appprivatecatalogconfiguration
}

