Localowner --> AndroidMCPbridge.AndroidbridgeAPK.ComposemanagementUI <<Relationship-UmVsYXRpb25zaGlw>> : "Manages local settings and reviews protected approvals"
CompatibleARCclient --> AndroidMCPbridge.AndroidbridgeAPK.ArcEngine <<Relationship-UmVsYXRpb25zaGlw>> : "Inspects approved target tree/frames and requests guarded input\n<size:14>[arc-protobuf-v1 loopback TCP]</size>"
AndroidMCPbridge.AndroidbridgeAPK.BridgeService --> AndroidMCPbridge.AndroidbridgeAPK.ArcEngine <<Relationship-UmVsYXRpb25zaGlw>> : "Owns enabled ARC listener lifecycle"
AndroidMCPbridge.AndroidbridgeAPK.BridgeService --> AndroidOSandtargetapps <<Relationship-UmVsYXRpb25zaGlw>> : "Requests eligible foreground promotion and truthful notification"
AndroidMCPbridge.AndroidbridgeAPK.AdmissionGate --> AndroidMCPbridge.AndroidbridgeAPK.ComposemanagementUI <<Relationship-UmVsYXRpb25zaGlw>> : "Requests exact bounded Ask challenge after input quiescence; no automatic approval"
AndroidMCPbridge.AndroidbridgeAPK.ComposemanagementUI --> AndroidMCPbridge.AndroidbridgeAPK.AdmissionGate <<Relationship-UmVsYXRpb25zaGlw>> : "Returns exact challenge result or denial; same-process trust is disclosed"
AndroidMCPbridge.AndroidbridgeAPK.ClientAuthenticator --> AndroidMCPbridge.AndroidbridgeAPK.ArcEngine <<Relationship-UmVsYXRpb25zaGlw>> : "Revokes inbound streams and input leases"
AndroidMCPbridge.AndroidbridgeAPK.AdmissionGate --> AndroidMCPbridge.AndroidbridgeAPK.ClientAuthenticator <<Relationship-UmVsYXRpb25zaGlw>> : "Pins current principal and credential epoch"
AndroidMCPbridge.AndroidbridgeAPK.AdmissionGate --> AndroidMCPbridge.AndroidbridgeAPK.AuditLogger <<Relationship-UmVsYXRpb25zaGlw>> : "Records canonical admission decision"
AndroidMCPbridge.AndroidbridgeAPK.AuditLogger --> AndroidMCPbridge.AndroidbridgeAPK.SqliteStoreCoordinator <<Relationship-UmVsYXRpb25zaGlw>> : "Appends audit/logs and reads redacted snapshots through store coordinator"
AndroidMCPbridge.AndroidbridgeAPK.ComposemanagementUI --> AndroidMCPbridge.AndroidbridgeAPK.OwnerCommandFacade <<Relationship-UmVsYXRpb25zaGlw>> : "Submits typed CAS commands and observes immutable state"
