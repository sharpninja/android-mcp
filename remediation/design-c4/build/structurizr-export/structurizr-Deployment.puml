rectangle "Owner-operated remote host\n<size:16>[Deployment Node: Host loopback; logical protocol lines use owner adb forward]</size>" <<DeploymentNode-RWxlbWVudA==>> as ReferenceAndroid.Owneroperatedremotehost {
  rectangle "==MCP client\n<size:16>[Software System]</size>\n\nConsuming agent owns business decisions and selected context" <<Element-RWxlbWVudA==>> as ReferenceAndroid.Owneroperatedremotehost.MCPclient_1
