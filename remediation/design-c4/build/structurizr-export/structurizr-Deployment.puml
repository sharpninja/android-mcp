  rectangle "==ADB loopback forwarding\n<size:16>[Infrastructure Node: Owner-managed ADB transport]</size>\n\nadb forward --no-rebind tcp:0 to the selected phone loopback listener; allocated host port is recorded" <<Element-RWxlbWVudA==>> as ReferenceAndroid.Owneroperatedremotehost.ADBloopbackforwarding
}

rectangle "Build workstation\n<size:16>[Deployment Node: Existing pinned toolchain]</size>" <<DeploymentNode-RWxlbWVudA==>> as ReferenceAndroid.Buildworkstation {
  rectangle "==Offline catalog tooling\n<size:16>[Container: Python]</size>\n\nSource acquisition/extraction/schema validation and reference fixtures; no phone operations" <<Element-RWxlbWVudA==>> as ReferenceAndroid.Buildworkstation.Offlinecatalogtooling_1
  rectangle "==Documentation build\n<size:16>[Container: Gradle / Structurizr / Marp]</size>\n\nLocal model validation and Markdown/SVG/storyboard packaging; no deployed app" <<Element-RWxlbWVudA==>> as ReferenceAndroid.Buildworkstation.Documentationbuild_1
}

