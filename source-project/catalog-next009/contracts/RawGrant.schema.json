{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:android-binding-catalog:1.1.0:RawGrantConstraints",
  "type": "object",
  "properties": {
    "allowed_targets": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "allowed_handles": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "allowed_displays": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "max_items": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "allowed_targets",
    "allowed_handles",
    "allowed_displays",
    "max_items"
  ],
  "additionalProperties": false,
  "description": "Only the client_raw_grants.constraints_json scope. Connection, descriptor, code/flag bounds, hash and effect are authoritative SQL columns and forbidden here."
}
