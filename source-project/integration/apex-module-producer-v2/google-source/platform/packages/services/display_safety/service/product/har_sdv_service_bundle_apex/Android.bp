package {
    default_applicable_licenses: ["Android-Apache-2.0"],
    default_team: "trendy_team_aaos_display_safety_triage",
}

apex {
    name: "com.sdv.google.display_safety.services_bundle.apex",
    // The service bundle(s) to be included in the apex.
    // The service bundle(s) to be included in the apex.
    // native_shared_libs are moved to arch-specific blocks to avoid build errors on riscv64.
    prebuilts: [
        // SDV service bundles manifest file.
        "com.sdv.google.display_safety.services_bundle.apex.service_bundles_manifest",
        // Linker configuration to enable loading library from apex.
        "com.sdv.google.display_safety.services_bundle.apex.linker_config",
        // Orchestrator config for the data publiser.
        "VehicleDataServiceBundleOrchestration-orch-config",
        // Orchestrator config for the fake data producer.
        "FakeVehicleDataServiceBundleOrchestration-orch-config",
        // Orchestration config to start the HAR-SDV bundle.
        "HarSdvServiceBundle-orch-config",
        // ACL policy of har_sdv_service service bundle.
        "com.google.display_safety.har.har_sdv_service.acl_policy",
        // har_sdv_vehicle_data_publisher
        "com.google.display_safety.har.har_sdv_vehicle_data_publisher.acl_policy",
    ],
    // Json manifest file describes metadata of the APEX package.
    // The 'name' filed from the json is used as mounting point.
    manifest: "apex_manifest.json",
    // Setting the security contexts to files in this APEX bundle.
    file_contexts: "apex_file_contexts",
    // Name of the apex_key module that provides the private key to sign the APEX bundle.
    key: "com.google.display_safety.har.key",
    // Mark apex as non-updatable for now, this might be revisited going forward.
    updatable: false,
    // Service bundle package is installed into /product partition.
    product_specific: true,
    arch: {
        arm64: {
            native_shared_libs: [
                "libhar_sdv_vehicle_data_publisher_service_bundle",
                "libhar_sdv_fake_vehicle_data_publisher_service_bundle",
                "libhar_sdv_service_bundle",
            ],
        },
        x86_64: {
            native_shared_libs: [
                "libhar_sdv_vehicle_data_publisher_service_bundle",
                "libhar_sdv_fake_vehicle_data_publisher_service_bundle",
                "libhar_sdv_service_bundle",
            ],
        },
        riscv64: {
            enabled: false,
        },
    },
}

// SDV manifest file with the vehicle data sender and fake demo sequence.
prebuilt_etc {
    name: "com.sdv.google.display_safety.services_bundle.apex.service_bundles_manifest",
    // The source filename of the manifest file.
    src: "har_sdv_vehicle_data_publisher_service_bundle.manifest.textproto",
    // The name of the installed file needs be `sdv_service_bundles_manifest.textproto`.
    filename: "sdv_service_bundles_manifest.textproto",
    // Disable direct installation of the prebuilt to one of the partitions.
    // The manifest is used only inside of an apex.
    installable: false,
}

// The linker config to allow libraries for the apex to be linkable.
linker_config {
    name: "com.sdv.google.display_safety.services_bundle.apex.linker_config",
    src: "har_sdv_vehicle_data_apex_linker.config.json",
    // Disable direct installation of the prebuilt to one of the partitions.
    // The linker configuration is used only inside of an apex.
    installable: false,
}

// Orchestration configurations of service bundles stored in the apex.
prebuilt_etc {
    name: "VehicleDataServiceBundleOrchestration-orch-config",
    // The source name of the manifest file.
    src: "VehicleDataServiceBundleOrchestration.textproto",
    filename: "VehicleDataServiceBundleOrchestration.textproto",
    sub_dir: "orch",
    // Disable direct installation of the manifest to one of the partitions.
    // The manifest will be used only inside of service bundles registry apexes.
    installable: false,
}

prebuilt_etc {
    name: "FakeVehicleDataServiceBundleOrchestration-orch-config",
    // The source name of the manifest file.
    src: "FakeVehicleDataServiceBundleOrchestration.textproto",
    filename: "FakeVehicleDataServiceBundleOrchestration.textproto",
    sub_dir: "orch",
    // Disable direct installation of the manifest to one of the partitions.
    // The manifest will be used only inside of service bundles registry apexes.
    installable: false,
}

prebuilt_etc {
    name: "HarSdvServiceBundle-orch-config",
    // The source name of the manifest file.
    src: "HarSdvServiceBundleOrchestration.textproto",
    filename: "HarSdvServiceBundleOrchestration.textproto",
    sub_dir: "orch",
    // Disable direct installation of the manifest to one of the partitions.
    // The manifest will be used only inside of service bundles registry apexes.
    installable: false,
}

// File with the ACL policy of har_sdv_service service bundle is stored in the apex.
prebuilt_etc {
    name: "com.google.display_safety.har.har_sdv_service.acl_policy",
    // The source name of the manifest file.
    src: "acl_configs/har_sdv_service/acl.textproto",
    sub_dir: "acls",
    filename: "har_sdv_service_acl.textproto",
    // Disable direct installation of the manifest to one of the partitions.
    // The manifest will be used only inside of service bundles registry apexes.
    installable: false,
    // Reduce prebuilt visibility to avoid adding it in another APEX.
    visibility: ["//visibility:private"],
}

// File with the ACL policy of har_sdv_vehicle_data_publisher service bundle is stored in the apex.
prebuilt_etc {
    name: "com.google.display_safety.har.har_sdv_vehicle_data_publisher.acl_policy",
    // The source name of the manifest file.
    src: "acl_configs/har_sdv_vehicle_data_publisher/acl.textproto",
    sub_dir: "acls",
    filename: "har_sdv_vehicle_data_publisher_acl.textproto",
    // Disable direct installation of the manifest to one of the partitions.
    // The manifest will be used only inside of service bundles registry apexes.
    installable: false,
    // Reduce prebuilt visibility to avoid adding it in another APEX.
    visibility: ["//visibility:private"],
}
