package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

apex {
    name: "com.android.sdv.sample.benchmarks.ethernet_vsock",
    manifest: "apex_manifest.json",
    key: "com.android.sdv.sample.benchmarks.ethernet_vsock.key",
    certificate: ":com.android.sdv.sample.benchmarks.ethernet_vsock.certificate",

    binaries: [
        "sdv_benchmark_ethernet_vsock_client",
        "sdv_benchmark_ethernet_vsock_server",
    ],
    compile_multilib: "both",
    updatable: false,
    platform_apis: true,
    product_specific: true,
    // The SELinux security contexts (or labels) assigned the executable and other files within the
    // APEX. It allows the definition of SELinux policies for these files.
    file_contexts: "file_contexts",
}

apex_key {
    name: "com.android.sdv.sample.benchmarks.ethernet_vsock.key",
    public_key: "com.android.sdv.sample.benchmarks.ethernet_vsock.avbpubkey",
    private_key: "com.android.sdv.sample.benchmarks.ethernet_vsock.pem",
}

android_app_certificate {
    name: "com.android.sdv.sample.benchmarks.ethernet_vsock.certificate",
    certificate: "com.android.sdv.sample.benchmarks.ethernet_vsock",
}
