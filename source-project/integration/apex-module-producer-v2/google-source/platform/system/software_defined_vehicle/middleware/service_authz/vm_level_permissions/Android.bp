package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

apex_defaults {
    name: "com.oem.sdv.authz.allow_all.defaults",
    key: "com.android.sdv.samples.key",
    prebuilts: [
        "allow_all_vm_permissions.textproto",
    ],
    min_sdk_version: "37",
    updatable: true,
}

// "com.oem.sdv.authz" APEX for VM level permissions on Core (on /product partition).
apex {
    name: "com.oem.sdv.authz.allow_all.core",
    defaults: ["com.oem.sdv.authz.allow_all.defaults"],
    file_contexts: "system_file_contexts",
    product_specific: true,
    overrides: [
        "com.oem.sdv.authz.allow_all.ivi",
    ],
}

// "com.oem.sdv.authz" APEX for VM level permissions on IVI (on /vendor partition).
apex {
    name: "com.oem.sdv.authz.allow_all.ivi",
    defaults: ["com.oem.sdv.authz.allow_all.defaults"],
    file_contexts: "vendor_file_contexts",
    vendor: true,
    overrides: [
        "com.oem.sdv.authz.allow_all.core",
    ],
}

prebuilt_etc {
    name: "allow_all_vm_permissions.textproto",
    src: "allow_all_vm_permissions.textproto",
    filename: ".default.textproto",
    installable: false,
}
