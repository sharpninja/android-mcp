package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

apex {
    name: "com.android.sdv.test.authz.local_vm_acl_policy_provider",
    manifest: "apex_manifest.json",
    key: "com.android.sdv.test.authz.local_vm_acl_policy_provider.key",
    certificate: ":com.android.sdv.test.authz.local_vm_acl_policy_provider.certificate",
    // Security contexts to files in the APEX.
    file_contexts: "file_contexts",
    native_shared_libs: [
        // Rust Authz Test service bundle to be included in the apex.
        "liboem_authz_service_bundle_test",
    ],
    prebuilts: [
        "com.android.sdv.test.authz.local_vm_acl_policy_provider.manifest",
        "com.android.sdv.test.authz.local_vm_acl_policy_provider.acl_policy",
    ],
    // TODO(b/333868045): make it updatable when all SDV dependencies are ready.
    updatable: false,
    // This module is installed into /product partition.
    product_specific: true,
}

apex_key {
    name: "com.android.sdv.test.authz.local_vm_acl_policy_provider.key",
    public_key: "com.android.sdv.test.authz.local_vm_acl_policy_provider.avbpubkey",
    private_key: "com.android.sdv.test.authz.local_vm_acl_policy_provider.pem",
}

android_app_certificate {
    name: "com.android.sdv.test.authz.local_vm_acl_policy_provider.certificate",
    certificate: "com.android.sdv.test.authz.local_vm_acl_policy_provider",
}

// SDV manifest file with the metadata information about service bundles stored in the apex.
prebuilt_etc {
    name: "com.android.sdv.test.authz.local_vm_acl_policy_provider.manifest",
    // The source name of the manifest file.
    src: "sdv_service_bundles_manifest.textproto",
    filename: "sdv_service_bundles_manifest.textproto",
    // Disable direct installation of the manifest to one of the partitions.
    // The manifest will be used only inside of service bundles registry apexes.
    installable: false,
}

// File with the ACL policy of service bundle is stored in the apex.
prebuilt_etc {
    name: "com.android.sdv.test.authz.local_vm_acl_policy_provider.acl_policy",
    // The source name of the manifest file.
    src: "AuthzTestAclPolicy.textproto",
    filename: "AuthzTestAclPolicy.textproto",
    sub_dir: "config/access_control",
    // Disable direct installation of the manifest to one of the partitions.
    // The manifest will be used only inside of service bundles registry apexes.
    installable: false,
}
