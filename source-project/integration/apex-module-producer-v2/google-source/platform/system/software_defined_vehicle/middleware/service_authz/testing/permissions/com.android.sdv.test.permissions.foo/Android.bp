package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

// Apex with AuthzTestedService.
apex {
    name: "com.android.sdv.test.permissions.foo",
    defaults: ["cuj_sample_apex@defaults"],
    native_shared_libs: ["libauthz_tested_service_permissions"],
    prebuilts: [
        // SDV service bundles manifest file.
        "com.android.sdv.test.permissions.foo.service_bundles_manifest",
        // Orchestration configuration.
        "com.android.sdv.test.permissions.foo.tested_service.orch.config",
        // Permissions policy file.
        "com.android.sdv.test.permissions.foo.tested_service.permissions.config",
    ],
    // Setting the security contexts to files in this APEX bundle.
    file_contexts: "apex_file_contexts",
}

// SDV manifest file with the metadata information about service bundles stored in the apex.
prebuilt_etc {
    name: "com.android.sdv.test.permissions.foo.service_bundles_manifest",
    // The source name of the manifest file.
    src: "sdv_service_bundles_manifest.textproto",
    // The name of the installed file shall be `sdv_service_bundles_manifest.textproto`.
    filename: "sdv_service_bundles_manifest.textproto",
    // Disable direct installation of the manifest to one of the partitions.
    // The manifest will be used only inside of service bundles registry apexes.
    installable: false,
}

// Orchestration configuration for AuthzTestedService service bundle.
prebuilt_etc {
    name: "com.android.sdv.test.permissions.foo.tested_service.orch.config",
    src: "service_bundle_config.textproto",
    // Subdirectory under which the file(s) to be installed into.
    sub_dir: "orch",
    // Filename is used in sdv service bundle metadata manifest.
    filename: "orch.textproto",
    // Disable direct installation of the configuration to one of the partitions.
    // The configuration will be used only inside of service bundles registry apexes.
    installable: false,
}

// Permissions policy for AuthzTestedService service bundle.
prebuilt_etc {
    name: "com.android.sdv.test.permissions.foo.tested_service.permissions.config",
    src: "permissions.textproto",
    sub_dir: "permissions",
    // Filename is used in sdv service bundle metadata manifest.
    filename: "permissions.textproto",
    // Disable direct installation of the manifest to one of the partitions.
    // The manifest will be used only inside of service bundles registry apexes.
    installable: false,
}

// Service bundle AuthzTestedService library.
rust_ffi_shared {
    name: "libauthz_tested_service_permissions",
    crate_name: "authz_tested_service_permissions",
    srcs: ["tested_service.rs"],
    defaults: [
        "tests_authz_service_bundle@defaults",
    ],
    rustlibs: [
        "liblazy_static",
    ],
    // Allows the library to be available inside of the related APEX.
    apex_available: ["com.android.sdv.test.permissions.foo"],
}
