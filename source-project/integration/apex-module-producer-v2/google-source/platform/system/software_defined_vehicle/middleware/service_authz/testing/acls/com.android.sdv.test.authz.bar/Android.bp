package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

// Apex with AuthzTestDriver.
apex {
    name: "com.android.sdv.test.authz.bar",
    defaults: ["cuj_sample_apex@defaults"],
    native_shared_libs: ["libauthz_test_driver"],
    prebuilts: [
        // SDV service bundles manifest file.
        "com.android.sdv.test.authz.bar.service_bundles_manifest",
        // Orchestration configuration.
        "com.android.sdv.test.authz.bar.test_driver.orch.config",
        // ACLs policy file.
        "com.android.sdv.test.authz.bar.test_driver.acls.config",
    ],
    // Setting the security contexts to files in this APEX bundle.
    file_contexts: "apex_file_contexts",
}

// SDV manifest file with the metadata information about service bundles stored in the apex.
prebuilt_etc {
    name: "com.android.sdv.test.authz.bar.service_bundles_manifest",
    // The source name of the manifest file.
    src: "sdv_service_bundles_manifest.textproto",
    // The name of the installed file shall be `sdv_service_bundles_manifest.textproto`.
    filename: "sdv_service_bundles_manifest.textproto",
    // Disable direct installation of the manifest to one of the partitions.
    // The manifest will be used only inside of service bundles registry apexes.
    installable: false,
}

// Orchestration configuration for AuthzTestDriver service bundle.
prebuilt_etc {
    name: "com.android.sdv.test.authz.bar.test_driver.orch.config",
    src: "authz_test_driver_orch.textproto",
    // Subdirectory under which the file(s) to be installed into.
    sub_dir: "orch",
    // Filename is used in sdv service bundle metadata manifest.
    filename: "authz_test_driver_orch.textproto",
    // Disable direct installation of the configuration to one of the partitions.
    // The configuration will be used only inside of service bundles registry apexes.
    installable: false,
}

// ACLs policy for AuthzTestDriver service bundle.
prebuilt_etc {
    name: "com.android.sdv.test.authz.bar.test_driver.acls.config",
    src: "authz_test_driver_acls.textproto",
    sub_dir: "acls",
    // Filename is used in sdv service bundle metadata manifest.
    filename: "authz_test_driver_acls.textproto",
    // Disable direct installation of the manifest to one of the partitions.
    // The manifest will be used only inside of service bundles registry apexes.
    installable: false,
}

// AuthzTestDriver service bundle library.
rust_ffi_shared {
    name: "libauthz_test_driver",
    crate_name: "authz_test_driver",
    srcs: ["authz_test_driver_native_library.rs"],
    defaults: [
        "tests_authz_service_bundle@defaults",
    ],
    rustlibs: [
        "liblazy_static",
    ],
    // Allows the library to be available inside of the related APEX.
    apex_available: ["com.android.sdv.test.authz.bar"],
}
