package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

apex {
    name: "com.google.sdv.telemetry",
    package_name: "com.google.sdv.telemetry",
    key: "com.android.sdv.samples.key",
    file_contexts: "file_contexts",
    prebuilts: [
        // SDV Manifest - used by SBR
        "com.android.sdv.telemetry.manifest",
        // Authz Policy
        "com.android.sdv.telemetry.permissions",
    ],
    visibility: [
        "//system/software_defined_vehicle/telemetry/src/telemetry_service_agent",
    ],
    product_specific: true,
    min_sdk_version: "35",
    updatable: true,
}

// SDV manifest file.
prebuilt_etc {
    name: "com.android.sdv.telemetry.manifest",
    src: "sdv_service_bundles_manifest.textproto",
    filename: "sdv_service_bundles_manifest.textproto",
    installable: false,
    visibility: ["//visibility:private"],
}

// File with authz policies of service bundle is stored in the apex.
prebuilt_etc {
    name: "com.android.sdv.telemetry.permissions",
    src: "permissions.textproto",
    filename: "permissions.textproto",
    installable: false,
    visibility: ["//visibility:private"],
}
