package {
    default_applicable_licenses: [
        "Android-Apache-2.0",
    ],
}

apex {
    name: "com.android.sdv.sample.hello.apex",
    defaults: [
        "com.android.sdv.sample.hello.apex.defaults",
    ],
}

apex_defaults {
    name: "com.android.sdv.sample.hello.apex.defaults",
    binaries: [
        "sdv_hello_apex",
    ], // List of native executables that are embedded inside this APEX
    manifest: "apex_manifest.json", // Json manifest file describing meta info of this APEX bundle.
    compile_multilib: "both", // control whether this module compiles for 32-bit, 64-bit, or both.
    product_specific: true, // this module extends system, and installed into /product
    file_contexts: "file_contexts", // Determines the file contexts file for setting the security contexts to files in this APEX bundle
    updatable: true,
    min_sdk_version: "33", // should be set when updatable is true
    key: "com.android.sdv.samples.key", // Name of the apex_key module that provides the private key to sign this APEX bundle
}
