package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

apex {
    name: "com.android.sdv.vpm.vehicle.client.subscriber",
    key: "com.android.sdv.samples.key",
    file_contexts: "file_contexts",
    prebuilts: [
        // SDV Manifest - used by SBR
        "com.android.sdv.vpm.vehicle.client.subscriber.manifest",
        // Authz Policy
        "com.android.sdv.vpm.vehicle.client.subscriber.permissions",
    ],
    product_specific: true,
    min_sdk_version: "35",
    updatable: true,
}

// SDV manifest file.
prebuilt_etc {
    name: "com.android.sdv.vpm.vehicle.client.subscriber.manifest",
    // The source name of the manifest file.
    src: "sdv_service_bundles_manifest.textproto",
    // The name of the installed file shall be `sdv_service_bundles_manifest.textproto`.
    filename: "sdv_service_bundles_manifest.textproto",
    // Disable direct installation of the manifest to one of the partitions.
    // The manifest will be used only inside of service bundles registry apexes.
    installable: false,
    // Reduce prebuilt visibility to avoid adding it in another APEX.
    visibility: ["//visibility:private"],
}

// File with the Authz policy of service bundle is stored in the apex.
prebuilt_etc {
    name: "com.android.sdv.vpm.vehicle.client.subscriber.permissions",
    // The source name of the manifest file.
    src: "permissions.textproto",
    filename: "permissions.textproto",
    // Disable direct installation of the manifest to one of the partitions.
    // The manifest will be used only inside of service bundles registry apexes.
    installable: false,
    // Reduce prebuilt visibility to avoid adding it in another APEX.
    visibility: ["//visibility:private"],
}
