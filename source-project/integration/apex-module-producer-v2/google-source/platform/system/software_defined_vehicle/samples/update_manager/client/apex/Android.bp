package {
    default_applicable_licenses: [
        "Android-Apache-2.0",
    ],
}

apex {
    name: "com.android.sdv.sample.update_manager.client",
    binaries: [
        "sdv_update_manager_client",
    ], // List of native executables that are embedded inside this APEX
    manifest: "apex_manifest.json", // Json manifest file describing meta info of this APEX bundle.
    compile_multilib: "64",
    file_contexts: "file_contexts", // Determines the file contexts file for setting the security contexts to files in this APEX bundle
    prebuilts: [
        // SDV service bundles manifest file.
        "com.android.sdv.sample.update_manager.client.manifest",
        // Update manager ACL policy file.
        "com.android.sdv.sample.update_manager.client.acl_policy",
    ],
    updatable: true,
    min_sdk_version: "35",
    key: "com.android.sdv.sample.update_manager.client.key",
    product_specific: true,
    certificate: ":com.android.sdv.sample.update_manager.client.certificate",
}

apex_key {
    name: "com.android.sdv.sample.update_manager.client.key",
    public_key: "com.android.sdv.sample.update_manager.client.avbpubkey",
    private_key: "com.android.sdv.sample.update_manager.client.pem",
}

android_app_certificate {
    name: "com.android.sdv.sample.update_manager.client.certificate",
    certificate: "com.android.sdv.sample.update_manager.client",
}

// Update manager SDV service bundles manifest file prebuilt.
prebuilt_etc {
    name: "com.android.sdv.sample.update_manager.client.manifest",
    // The source name of the manifest file.
    src: "sdv_service_bundles_manifest.textproto",
    // The name of the installed file shall be `sdv_service_bundles_manifest.textproto`.
    filename: "sdv_service_bundles_manifest.textproto",
    // Disable direct installation of the manifest to one of the partitions.
    // The manifest will be used only inside of service bundles registry apexes.
    installable: false,
    // Reduce prebuilt visibility to avoid adding it in another APEX.
    visibility: ["//visibility:private"],
}

// File with the ACL policy of service bundle is stored in the apex.
prebuilt_etc {
    name: "com.android.sdv.sample.update_manager.client.acl_policy",
    // The source name of the manifest file.
    src: "acl.textproto",
    filename: "acl.textproto",
    // Disable direct installation of the manifest to one of the partitions.
    // The manifest will be used only inside of service bundles registry apexes.
    installable: false,
    // Reduce prebuilt visibility to avoid adding it in another APEX.
    visibility: ["//visibility:private"],
}
