package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

// Apex with sample SOME/IP services.
apex {
    name: "com.android.sdv.sample.someip",
    manifest: "apex_manifest.json",
    // Name of the `apex_key` module that provides the private key to sign the APEX package.
    key: "com.android.sdv.samples.key",
    native_shared_libs: [
        // Library for ServiceBundleCuj26
        "libcuj26_someip_sample",
        // Library for ServiceBundleCuj23Foo
        "libcuj23_someip_foo_sample",
        // Library for ServiceBundleCuj23Bar
        "libcuj23_someip_bar_sample",
        // Library for SomeIpBenchmark
        "libsomeip_benchmark_sample",
        // Library for TemperatureSensor
        "libtemperature_publisher_someip",
        // Library for RearTireService
        "libmiddleware_someip_sample",
        // Library for SdvHelloService
        "libsomeip_rpc_sdv_server",
        // Library for HelloService
        "libsomeip_rpc_someip_server",
        // Library for RobustnessChecker
        "librobustness_sample_someip",
    ],
    prebuilts: [
        // Linker configuration to enable loading library from apex.
        "com.android.sdv.sample.someip.linker_config",
        // SDV service bundles manifest file.
        "com.android.sdv.sample.someip.service_bundles_manifest",
        // VSIDL config for ServiceBundleCuj26
        "com.android.sdv.sample.someip.ServiceBundleCuj26-vsidl-config.binpb",
        // VSIDL config for ServiceBundleCuj23Bar
        "com.android.sdv.sample.someip.ServiceBundleCuj23Bar-vsidl-config.binpb",
        // VSIDL config for ServiceBundleCuj23Foo
        "com.android.sdv.sample.someip.ServiceBundleCuj23Foo-vsidl-config.binpb",
        // VSIDL config for SomeIpBenchmark
        "com.android.sdv.sample.someip.SomeIpBenchmark-vsidl-config.binpb",
        // VSIDL config for TemperatureSensor
        "com.android.sdv.sample.someip.TemperatureSensor-vsidl-config.binpb",
        // VSIDL config for RobustnessChecker
        "com.android.sdv.sample.someip.RobustnessChecker-vsidl-config.binpb",
        // VSIDL config for CarlaSomeipClient
        "com.android.sdv.sample.someip.CarlaSomeipClient-vsidl-config.binpb",
        // ACL policies for samples
        "com.android.sdv.sample.someip.policies",
        // ACL policies for TestClient
        "com.android.sdv.sample.someip.test_client.acl_policy",
        // ACL policies for TemperatureSensor
        "com.android.sdv.sample.someip.multipub.acl_policy",
        // ACL policies for RearTireService
        "com.android.sdv.sample.someip.rear_tire.acl_policy",
        // ACL policies for ServiceBundleCuj26
        "com.android.sdv.sample.someip.service_bundle_cuj26_permissions.textproto",
        // ACL policies for SdvHelloService
        "com.android.sdv.sample.someip.hello_service.acl_policy",
        // ACL policies for RobustnessChecker
        "com.android.sdv.sample.someip.robustness.acl_policy",
        // Permissions for SomeipGroupEventConsumer
        "com.android.sdv.sample.someip.someip_group_event_consumer_permissions.textproto",
        // Permissions for SideMirrorTestClient
        "com.android.sdv.sample.someip.side_mirror_test_client_permissions.textproto",
        // Permissions for SomeIpBenchmark
        "com.android.sdv.sample.someip.some_ip_benchmark.textproto",
        // Permissions for HeyServiceClient
        "com.android.sdv.sample.someip.hey_service_client_permissions.textproto",
        // Permissions for SdvIntegrationTestServer
        "com.android.sdv.sample.someip.sdv_integration_test_server_permissions.textproto",
        // Permissions for ObjectSensorConsumer
        "com.android.sdv.sample.someip.object_sensor_consumer_permissions.textproto",
        // Permissions for ServiceBundleCuj23Bar
        "com.android.sdv.sample.someip.service_bundle_cuj23_bar_permissions.textproto",
        // Permissions for ServiceBundleCuj23Foo
        "com.android.sdv.sample.someip.service_bundle_cuj23_foo_permissions.textproto",
        // Permissions for ByteForwardingConsumer
        "com.android.sdv.sample.someip.byte_forwarding_consumer_permissions.textproto",
    ],
    // Setting the security contexts to files in this APEX bundle.
    file_contexts: "apex_file_contexts",
    // Optional, see prebuilt_etc below
    updatable: true,
    // You have to define it with updatable:true
    min_sdk_version: "35",
    product_specific: true,
}

// File with the ACL policy of service bundle is stored in the apex.
prebuilt_etc {
    name: "com.android.sdv.sample.someip.rear_tire.acl_policy",
    // The source name of the manifest file.
    src: "rear_tire_acl.textproto",
    filename: "rear_tire_acl.textproto",
    // Disable direct installation of the manifest to one of the partitions.
    // The manifest will be used only inside of service bundles registry apexes.
    installable: false,
    // Reduce prebuilt visibility to avoid adding it in another APEX.
    visibility: ["//visibility:private"],
}

// File with the permissions policy of service bundle is stored in the apex.
prebuilt_etc {
    name: "com.android.sdv.sample.someip.service_bundle_cuj26_permissions.textproto",
    src: "service_bundle_cuj26_permissions.textproto",
    filename: "service_bundle_cuj26_permissions.textproto",
    installable: false,
    visibility: ["//visibility:private"],
}

// SDV manifest file with the metadata information about service bundles stored in the apex.
prebuilt_etc {
    name: "com.android.sdv.sample.someip.service_bundles_manifest",
    // The source name of the manifest file.
    src: "sdv_service_bundles_manifest.textproto",
    // The name of the installed file shall be `sdv_service_bundles_manifest.textproto`.
    filename: "sdv_service_bundles_manifest.textproto",
    // Disable direct installation of the manifest to one of the partitions.
    // The manifest will be used only inside of service bundles registry apexes.
    installable: false,
}

// File with the ACL policy of service bundle is stored in the apex.
prebuilt_etc {
    name: "com.android.sdv.sample.someip.test_client.acl_policy",
    // The source name of the manifest file.
    src: "test_client.acl.textproto",
    filename: "test_client.acl.textproto",
    // Disable direct installation of the manifest to one of the partitions.
    // The manifest will be used only inside of service bundles registry apexes.
    installable: false,
    // Reduce prebuilt visibility to avoid adding it in another APEX.
    visibility: ["//visibility:private"],
}

// File with the ACL policy of service bundle is stored in the apex.
prebuilt_etc {
    name: "com.android.sdv.sample.someip.multipub.acl_policy",
    // The source name of the manifest file.
    src: "multipub_acl.textproto",
    filename: "multipub_acl.textproto",
    // Disable direct installation of the manifest to one of the partitions.
    // The manifest will be used only inside of service bundles registry apexes.
    installable: false,
    // Reduce prebuilt visibility to avoid adding it in another APEX.
    visibility: ["//visibility:private"],
}

// File with the ACL policy of service bundle is stored in the apex.
prebuilt_etc {
    name: "com.android.sdv.sample.someip.hello_service.acl_policy",
    // The source name of the manifest file.
    src: "sdv_hello_service_acl.textproto",
    filename: "sdv_hello_service_acl.textproto",
    // Disable direct installation of the manifest to one of the partitions.
    // The manifest will be used only inside of service bundles registry apexes.
    installable: false,
    // Reduce prebuilt visibility to avoid adding it in another APEX.
    visibility: ["//visibility:private"],
}

// File with the ACL policy of service bundle is stored in the apex.
prebuilt_etc {
    name: "com.android.sdv.sample.someip.robustness.acl_policy",
    // The source name of the manifest file.
    src: "robustness_acl.textproto",
    filename: "robustness_acl.textproto",
    // Disable direct installation of the manifest to one of the partitions.
    // The manifest will be used only inside of service bundles registry apexes.
    installable: false,
    // Reduce prebuilt visibility to avoid adding it in another APEX.
    visibility: ["//visibility:private"],
}

// File with the permissions policy of service bundle is stored in the apex.
prebuilt_etc {
    name: "com.android.sdv.sample.someip.someip_group_event_consumer_permissions.textproto",
    src: "someip_group_event_consumer_permissions.textproto",
    filename: "someip_group_event_consumer_permissions.textproto",
    installable: false,
    visibility: ["//visibility:private"],
}

// File with the permissions policy of service bundle is stored in the apex.
prebuilt_etc {
    name: "com.android.sdv.sample.someip.side_mirror_test_client_permissions.textproto",
    src: "side_mirror_test_client_permissions.textproto",
    filename: "side_mirror_test_client_permissions.textproto",
    installable: false,
    visibility: ["//visibility:private"],
}

// File with the permissions policy of service bundle is stored in the apex.
prebuilt_etc {
    name: "com.android.sdv.sample.someip.some_ip_benchmark.textproto",
    src: "some_ip_benchmark_permissions.textproto",
    filename: "some_ip_benchmark_permissions.textproto",
    installable: false,
    visibility: ["//visibility:private"],
}

// File with the permissions policy of service bundle is stored in the apex.
prebuilt_etc {
    name: "com.android.sdv.sample.someip.hey_service_client_permissions.textproto",
    src: "hey_service_client_permissions.textproto",
    filename: "hey_service_client_permissions.textproto",
    installable: false,
    visibility: ["//visibility:private"],
}

// File with the permissions policy of service bundle is stored in the apex.
prebuilt_etc {
    name: "com.android.sdv.sample.someip.sdv_integration_test_server_permissions.textproto",
    src: "sdv_integration_test_server_permissions.textproto",
    filename: "sdv_integration_test_server_permissions.textproto",
    installable: false,
    visibility: ["//visibility:private"],
}

// File with the permissions policy of service bundle is stored in the apex.
prebuilt_etc {
    name: "com.android.sdv.sample.someip.object_sensor_consumer_permissions.textproto",
    src: "object_sensor_consumer_permissions.textproto",
    filename: "object_sensor_consumer_permissions.textproto",
    installable: false,
    visibility: ["//visibility:private"],
}

// File with the permissions policy of service bundle is stored in the apex.
prebuilt_etc {
    name: "com.android.sdv.sample.someip.service_bundle_cuj23_bar_permissions.textproto",
    src: "service_bundle_cuj23_bar_permissions.textproto",
    filename: "service_bundle_cuj23_bar_permissions.textproto",
    installable: false,
    visibility: ["//visibility:private"],
}

// File with the permissions policy of service bundle is stored in the apex.
prebuilt_etc {
    name: "com.android.sdv.sample.someip.service_bundle_cuj23_foo_permissions.textproto",
    src: "service_bundle_cuj23_foo_permissions.textproto",
    filename: "service_bundle_cuj23_foo_permissions.textproto",
    installable: false,
    visibility: ["//visibility:private"],
}

// File with the permissions policy of service bundle is stored in the apex.
prebuilt_etc {
    name: "com.android.sdv.sample.someip.byte_forwarding_consumer_permissions.textproto",
    src: "byte_forwarding_consumer_permissions.textproto",
    filename: "byte_forwarding_consumer_permissions.textproto",
    installable: false,
    visibility: ["//visibility:private"],
}

// The linker config to allow SDV service bundle libraries to be linkable from apex.
linker_config {
    name: "com.android.sdv.sample.someip.linker_config",
    src: "linker.config.json",
    // Disable direct installation of the linker config to one of the partitions.
    // The linker configuration will be used only inside of service bundles registry apexes.
    installable: false,
}
