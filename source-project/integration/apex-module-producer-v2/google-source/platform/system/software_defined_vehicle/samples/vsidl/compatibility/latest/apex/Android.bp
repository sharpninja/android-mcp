package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

// Apex to store the com.android.sdv.sample.compatibility.latest sample.
apex {
    name: "com.android.sdv.sample.compatibility.latest",
    native_shared_libs: [
        "libsdv_lm_full_bundle",
    ],
    // Security contexts to files in the APEX.
    file_contexts: "file_contexts",
    // Json manifest file describing meta info of this APEX bundle.
    // The 'name' filed from this json is used for mounting point.
    manifest: "apex_manifest.json",
    // Control whether this module compiles for 32-bit, 64-bit, or both.
    compile_multilib: "both",
    prebuilts: [
        // SDV service bundles manifest file.
        "com.android.sdv.sample.compatibility.latest.manifest",
        // Linker configuration to enable loading library from apex.
        "com.android.sdv.sample.compatibility.latest.linker-config",
        // ACLs policy file.
        "com.android.sdv.sample.compatibility.latest.acls.config",
        // Orchestration configuration.
        "com.android.sdv.sample.compatibility.full_bundle.orch.config",
    ],
    // Name of the apex_key module that provides the private key to sign the APEX bundle.
    key: "com.android.sdv.sample.compatibility.latest.apex_key",
    // TODO(b/333868045): make it updatable when all SDV dependencies are ready.
    updatable: false,
    product_specific: true,
}

// The key for signing the apex.
apex_key {
    name: "com.android.sdv.sample.compatibility.latest.apex_key",
    public_key: "com.android.sdv.sample.compatibility.latest.avbpubkey",
    private_key: "com.android.sdv.sample.compatibility.latest.pem",
}

// SDV manifest file with the metadata information about service bundles stored in the apex.
prebuilt_etc {
    name: "com.android.sdv.sample.compatibility.latest.manifest",
    // The source name of the manifest file.
    src: "sdv_service_bundles_manifest.textproto",
    // The name of the installed file shall be `sdv_service_bundles_manifest.textproto`.
    filename: "sdv_service_bundles_manifest.textproto",
    // Disable direct installation of the manifest to one of the partitions.
    // The manifest will be used only inside of service bundles registry apexes.
    installable: false,
}

// The linker config to allow libraries for the apex to be linkable.
linker_config {
    name: "com.android.sdv.sample.compatibility.latest.linker-config",
    src: "linker.config.json",
    // Disable direct installation of the linker config to one of the partitions.
    // The linker configuration will be used only inside of service bundles registry apexes.
    installable: false,
}
