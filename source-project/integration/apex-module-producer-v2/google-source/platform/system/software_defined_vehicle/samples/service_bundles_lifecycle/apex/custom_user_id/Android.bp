package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

// Apex to store custom user id lifecycle sample.
apex {
    name: "com.android.sdv.sample.lifecycle.userid",
    native_shared_libs: [
        // Custom user id service bundle to be included in the apex.
        "liboem_service_bundle_custom_userid_sample",
    ],
    // Security contexts to files in the APEX.
    file_contexts: "lifecycle_sample_apex_file_contexts",
    // Json manifest file describing meta info of this APEX bundle.
    // The 'name' filed from this json is used for mounting point.
    manifest: "apex_manifest.json",
    prebuilts: [
        // SDV service bundles manifest file.
        "com.android.sdv.sample.lifecycle.userid.manifest",
        // Linker configuration to enable loading library from apex.
        "com.sdv.google.sample.lifecycle.linker-config",
    ],
    // Name of the apex_key module that provides the private key to sign the APEX bundle.
    key: "com.android.sdv.sample.lifecycle_key",
    // This APEX cannot be updated outside of full OTA/full system update.
    // TODO(b/399527905): flip this to true once APEX with VINTF update is supported.
    updatable: false,
    // The minimum sdk version supported by the APEX and all of (in)direct dependencies.
    min_sdk_version: "34",
    // Sample(s) package is installed into /product partition.
    product_specific: true,
}

// SDV manifest file with the metadata information about service bundles stored in the apex.
prebuilt_etc {
    name: "com.android.sdv.sample.lifecycle.userid.manifest",
    // The source name of the manifest file.
    src: "sdv_service_bundles_manifest.textproto",
    // The name of the installed file shall be `sdv_service_bundles_manifest.textproto`.
    filename: "sdv_service_bundles_manifest.textproto",
    // Disable direct installation of the manifest to one of the partitions.
    // The manifest will be used only inside of service bundles registry apexes.
    installable: false,
}
