package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

apex {
    name: "com.android.sdv.sample.diagnostics_update.v2",
    key: "com.android.sdv.samples.key",
    file_contexts: "file_contexts",
    prebuilts: [
        "com.android.sdv.sample.diagnostics_update.permissions.textproto.v2",
        "com.android.sdv.sample.diagnostics_update.linker_config_file",
        "com.android.sdv.sample.diagnostics_update.updatable_bundle_manifest.v2",
        "com.android.sdv.sample.diagnostics_update.UpdatableDiagnosticsBundle-diag-config.binpb-V2",
        "com.android.sdv.sample.diagnostics_update.UpdatableDiagnosticsBundle-vsidl-config.binpb-V2",
    ],
    native_shared_libs: [
        "libupdatable_diagnostics_bundle_v2",
    ],
    updatable: true,
    product_specific: true,
    min_sdk_version: "35",
}

prebuilt_etc {
    name: "com.android.sdv.sample.diagnostics_update.permissions.textproto.v2",
    src: "permissions.textproto",
    filename: "permissions.textproto",
    sub_dir: "permissions",
    installable: false,
}

prebuilt_etc {
    name: "com.android.sdv.sample.diagnostics_update.updatable_bundle_manifest.v2",
    src: "updatable_bundle_manifest.textproto",
    // filename needs to be the one defined below. One bundle manifest per apex file, containing
    // a bundle_metadata for each bundle in the apex
    filename: "sdv_service_bundles_manifest.textproto",
    installable: false,
}

filegroup {
    name: "catalog_cuj_apex_020_apex_v2",
    srcs: ["**/*"],
}
