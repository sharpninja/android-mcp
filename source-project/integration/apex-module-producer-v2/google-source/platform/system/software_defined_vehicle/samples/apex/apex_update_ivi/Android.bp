package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

// V1 target of the APEX, included in image
apex {
    name: "com.android.sdv.sample.ivi.service",
    binaries: [
        "ivi_service_bundle_apex_update",
    ],
    manifest: "v1/apex_manifest.json",
    compile_multilib: "both",
    vendor: true,
    file_contexts: "file_contexts",
    key: "com.android.sdv.sample.ivi.service.key",
    certificate: ":com.android.sdv.sample.ivi.service.certificate",
    updatable: true,
    min_sdk_version: "35",
    required: [
        "IVIServiceBundle-permissions",
    ],
}

prebuilt_etc {
    name: "IVIServiceBundle-permissions",
    src: "permissions.textproto",
    sub_dir: "sdv_authz_acls/com.android.sdv.sample.ivi.service",
    filename: "IVIServiceBundle.textproto",
    vendor: true,
}

// V2 target of the APEX, not included in image
apex {
    name: "com.android.sdv.sample.ivi.service.v2",
    binaries: [
        "ivi_service_bundle_apex_update_v2",
    ],
    manifest: "v2/apex_manifest.json",
    compile_multilib: "both",
    vendor: true,
    file_contexts: "file_contexts",
    key: "com.android.sdv.sample.ivi.service.key",
    certificate: ":com.android.sdv.sample.ivi.service.certificate",
    updatable: true,
    min_sdk_version: "35",
}

apex_key {
    name: "com.android.sdv.sample.ivi.service.key",
    public_key: "com.android.sdv.sample.ivi.service.avbpubkey",
    private_key: "com.android.sdv.sample.ivi.service.pem",
}

android_app_certificate {
    name: "com.android.sdv.sample.ivi.service.certificate",
    certificate: "com.android.sdv.sample.ivi.service",
}

cc_binary {
    name: "ivi_service_bundle_apex_update",
    srcs: ["IVIServiceBundle.cpp"],
    cppflags: [
        "-DIVI_SERVICE_BUNDLE_APEX_UPDATE_VERSION=1",
    ],
    shared_libs: [
        "libbase",
        "liblog",
        "libutils",
        "libcutils",
        "libbinder_ndk",
        "libcrypto",
        "libsdv_log",
        "libgrpc++",
        "libprotobuf-cpp-full",
        "libsdvgatewayclient",
    ],
    static_libs: [
        "libgrpc_tls_credentials_manager",
        "sdv_tire_status_protos",
        "cluster_protos",
        "libsdv_proto_reflection_cc",
        "libnative_sdv_gateway_test_app",
    ],
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
    vendor: true,
    min_sdk_version: "35",
}

cc_binary {
    name: "ivi_service_bundle_apex_update_v2",
    stem: "ivi_service_bundle_apex_update",
    srcs: ["IVIServiceBundle.cpp"],
    cppflags: [
        "-DIVI_SERVICE_BUNDLE_APEX_UPDATE_VERSION=2",
    ],
    shared_libs: [
        "libbase",
        "liblog",
        "libutils",
        "libcutils",
        "libbinder_ndk",
        "libcrypto",
        "libsdv_log",
        "libgrpc++",
        "libprotobuf-cpp-full",
        "libsdvgatewayclient",
    ],
    static_libs: [
        "libgrpc_tls_credentials_manager",
        "sdv_tire_status_protos_v2",
        "cluster_protos",
        "libsdv_proto_reflection_cc",
        "libnative_sdv_gateway_test_app",
    ],
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
    apex_available: [
        "com.android.sdv.sample.ivi.service.v2",
    ],
    vendor: true,
    min_sdk_version: "35",
}

genrule {
    name: "SdvTireStatusStub_h",
    tools: [
        "aprotoc",
        "protoc-gen-grpc-cpp-plugin",
    ],
    cmd: "$(location aprotoc) -I$$(dirname $(location :apex_sample_tire_status_rpc_proto)) -Iexternal/protobuf/src --plugin=protoc-gen-grpc=$(location protoc-gen-grpc-cpp-plugin) $(locations :apex_sample_tire_status_rpc_proto) --grpc_out=$(genDir) --cpp_out=$(genDir)",
    srcs: [
        ":apex_sample_tire_status_rpc_proto",
        ":libprotobuf-internal-protos",
    ],
    out: [
        "rpc.pb.h",
        "rpc.grpc.pb.h",
    ],
}

genrule {
    name: "SdvTireStatusStub_cc",
    tools: [
        "aprotoc",
        "protoc-gen-grpc-cpp-plugin",
    ],
    cmd: "$(location aprotoc) -I$$(dirname $(location :apex_sample_tire_status_rpc_proto)) -Iexternal/protobuf/src --plugin=protoc-gen-grpc=$(location protoc-gen-grpc-cpp-plugin) $(locations :apex_sample_tire_status_rpc_proto) --grpc_out=$(genDir) --cpp_out=$(genDir)",
    srcs: [
        ":apex_sample_tire_status_rpc_proto",
        ":libprotobuf-internal-protos",
    ],
    out: [
        "rpc.pb.cc",
        "rpc.grpc.pb.cc",
    ],
}

cc_library_static {
    name: "sdv_tire_status_protos",
    host_supported: true,
    include_dirs: [
        "external/protobuf/src",
    ],
    generated_headers: [
        "SdvTireStatusStub_h",
    ],
    export_generated_headers: [
        "SdvTireStatusStub_h",
    ],
    generated_sources: [
        "SdvTireStatusStub_cc",
    ],
    shared_libs: [
        "libgrpc++",
        "libprotobuf-cpp-lite",
    ],
    cflags: [
        // gRPC++ generated code is full of unused parameters.
        "-Wno-unused-parameter",
    ],
    vendor_available: true,
    min_sdk_version: "35",
}

genrule {
    name: "SdvTireStatusStubV2_h",
    tools: [
        "aprotoc",
        "protoc-gen-grpc-cpp-plugin",
    ],
    cmd: "$(location aprotoc) -I$$(dirname $(location :apex_sample_tire_status_rpc_proto_v2)) -Iexternal/protobuf/src --plugin=protoc-gen-grpc=$(location protoc-gen-grpc-cpp-plugin) $(locations :apex_sample_tire_status_rpc_proto_v2) --grpc_out=$(genDir) --cpp_out=$(genDir)",
    srcs: [
        ":apex_sample_tire_status_rpc_proto_v2",
        ":libprotobuf-internal-protos",
    ],
    out: [
        "rpc.pb.h",
        "rpc.grpc.pb.h",
    ],
}

genrule {
    name: "SdvTireStatusStubV2_cc",
    tools: [
        "aprotoc",
        "protoc-gen-grpc-cpp-plugin",
    ],
    cmd: "$(location aprotoc) -I$$(dirname $(location :apex_sample_tire_status_rpc_proto_v2)) -Iexternal/protobuf/src --plugin=protoc-gen-grpc=$(location protoc-gen-grpc-cpp-plugin) $(locations :apex_sample_tire_status_rpc_proto_v2) --grpc_out=$(genDir) --cpp_out=$(genDir)",
    srcs: [
        ":apex_sample_tire_status_rpc_proto_v2",
        ":libprotobuf-internal-protos",
    ],
    out: [
        "rpc.pb.cc",
        "rpc.grpc.pb.cc",
    ],
}

cc_library_static {
    name: "sdv_tire_status_protos_v2",
    host_supported: true,
    include_dirs: [
        "external/protobuf/src",
    ],
    generated_headers: [
        "SdvTireStatusStubV2_h",
    ],
    export_generated_headers: [
        "SdvTireStatusStubV2_h",
    ],
    generated_sources: [
        "SdvTireStatusStubV2_cc",
    ],
    shared_libs: [
        "libgrpc++",
        "libprotobuf-cpp-lite",
    ],
    cflags: [
        // gRPC++ generated code is full of unused parameters.
        "-Wno-unused-parameter",
    ],
    vendor_available: true,
    min_sdk_version: "35",
}
