package {
    default_applicable_licenses: ["Android-Apache-2.0"],
    default_team: "trendy_team_automotive",
}

// Configurable apex contains sdv manifest with vsidl and diagnostics configs.
// Configurable apex does not contain any service bundle libraries.
apex {
    name: "com.android.sdv.sample.vsidl_provider.apex_with_per_bundle_config_file",
    // Security contexts to files in the APEX.
    file_contexts: "vsidl_provider_sample_apex_file_contexts",
    // Json manifest file describing meta info of this APEX bundle.
    // The 'name' filed from this json is used for mounting point.
    manifest: "apex_manifest.json",
    prebuilts: [
        "com.android.sdv.sample.vsidl_provider.apex_with_per_bundle_config_file.DiagService-diag-config.binpb",
        "com.android.sdv.sample.vsidl_provider.apex_with_per_bundle_config_file.DiagService-vsidl-config.binpb",
        "com.android.sdv.sample.vsidl_provider.apex_with_per_bundle_config_file.Manager-vsidl-config.binpb",
        "com.android.sdv.sample.vsidl_provider.apex_with_per_bundle_config_file.Monitor-vsidl-config.binpb",
        "com.android.sdv.sample.vsidl_provider.apex_with_per_bundle_config_file.HelloService-vsidl-config.binpb",
        "com.android.sdv.sample.vsidl_provider.apex_with_per_bundle_config_file.OtherManager-vsidl-config.binpb",
        "com.android.sdv.sample.vsidl_provider.apex_with_per_bundle_config_file.OtherMonitor-vsidl-config.binpb",
        "com.android.sdv.sample.vsidl_provider.apex_with_per_bundle_config_file.sdv_manifest",
    ],
    // Name of the apex_key module that provides the private key to sign the APEX bundle.
    key: "com.android.sdv.sample.vsidl_provider.apex_with_per_bundle_config_file.key",
    // TODO(b/333868045): make it updatable when all SDV dependencies are ready.
    updatable: false,
    // This module is installed into /product partition.
    product_specific: true,
    // Reduce visibility to SDV core services samples.
    visibility: [
        "//system/software_defined_vehicle/core_services/samples",
        "//device/google/sdv",
    ],
}

apex_key {
    name: "com.android.sdv.sample.vsidl_provider.apex_with_per_bundle_config_file.key",
    public_key: "com.android.sdv.sample.vsidl_provider.apex_with_per_bundle_config_file.avbpubkey",
    private_key: "com.android.sdv.sample.vsidl_provider.apex_with_per_bundle_config_file.pem",
}

// SDV manifest file with the metadata information about service bundles stored in the apex.
prebuilt_etc {
    name: "com.android.sdv.sample.vsidl_provider.apex_with_per_bundle_config_file.sdv_manifest",
    // The source name of the manifest file.
    src: "sdv_service_bundles_manifest.textproto",
    // The name of the installed file shall be `sdv_service_bundles_manifest.textproto`.
    filename: "sdv_service_bundles_manifest.textproto",
    // Disable direct installation of the manifest to one of the partitions.
    // The manifest will be used only inside of service bundles registry apexes.
    installable: false,
    // Reduce prebuilt visibility to avoid adding it in another APEX.
    visibility: ["//visibility:private"],
}
