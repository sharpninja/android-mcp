package {
    default_team: "trendy_team_automotive",
    default_applicable_licenses: ["Android-Apache-2.0"],
}

// Configurable apex contains sdv manifest with an external protocol mapping.
// Configurable apex does not contain any service bundle libraries.
apex {
    name: "com.android.sdv.sample.service_bundles_registry.apex_configurable",
    defaults: ["service_bundles_registry_samples@apex_defaults"],
    visibility: ["//device/google/sdv"],
    prebuilts: [
        // SDV service bundles manifest file.
        "com.android.sdv.sample.service_bundles_registry.apex_configurable.sdv_manifest",
        // External protocol mapping configuration.
        "com.android.sdv.sample.service_bundles_registry.apex_configurable.external_protocol_mapping",
    ],
}

// SDV manifest file.
prebuilt_etc {
    name: "com.android.sdv.sample.service_bundles_registry.apex_configurable.sdv_manifest",
    // The source name of the manifest file.
    src: "sdv_manifest.textproto",
    // The name of the installed file shall be `sdv_service_bundles_manifest.textproto`.
    filename: "sdv_service_bundles_manifest.textproto",
    // Disable direct installation of the manifest to one of the partitions.
    // The manifest will be used only inside of service bundles registry apexes.
    installable: false,
    // Reduce prebuilt visibility to avoid adding it in another APEX.
    visibility: ["//visibility:private"],
}

// External protocol mapping configuration.
prebuilt_etc {
    name: "com.android.sdv.sample.service_bundles_registry.apex_configurable.external_protocol_mapping",
    // The source name of the file.
    src: "external_service_bundle_protocol_mapping.binpb",
    // The file name to be used when installed.
    filename: "external_protocol_mapping.binpb",
    // Disable direct installation of the manifest to one of the partitions.
    // The manifest will be used only inside of service bundles registry apexes.
    installable: false,
}
