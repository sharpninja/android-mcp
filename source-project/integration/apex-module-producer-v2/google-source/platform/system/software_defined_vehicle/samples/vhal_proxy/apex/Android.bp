package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

apex {
    name: "com.android.sdv.sample.vsidl_vhal_proxy_integration",
    manifest: "apex_manifest.json",
    key: "com.android.sdv.sample.vsidl_vhal_proxy_integration.key",
    certificate: ":com.android.sdv.sample.vsidl_vhal_proxy_integration.certificate",
    // The sdv_core_cf target is based on vsoc_x86_64
    compile_multilib: "64",
    product_specific: true,
    file_contexts: "file_contexts",
    // Optional, see prebuilt_etc below
    prebuilts: [
        "com.android.sdv.sample.vsidl_vhal_proxy_integration.manifest",
        "com.android.sdv.sample.vsidl_vhal_proxy_integration.tire_pressure.acl_policy",
    ],
    updatable: false,
}

apex_key {
    name: "com.android.sdv.sample.vsidl_vhal_proxy_integration.key",
    public_key: "com.android.sdv.sample.vsidl_vhal_proxy_integration.avbpubkey",
    private_key: "com.android.sdv.sample.vsidl_vhal_proxy_integration.pem",
}

android_app_certificate {
    name: "com.android.sdv.sample.vsidl_vhal_proxy_integration.certificate",
    certificate: "com.android.sdv.sample.vsidl_vhal_proxy_integration",
}

// SDV service bundles manifest file prebuilt.
prebuilt_etc {
    name: "com.android.sdv.sample.vsidl_vhal_proxy_integration.manifest",
    // The source name of the manifest file.
    src: "sdv_service_bundles_manifest.textproto",
    // The name of the installed file shall be `sdv_service_bundles_manifest.textproto`.
    filename: "sdv_service_bundles_manifest.textproto",
    // Disable direct installation of the manifest to one of the partitions.
    // The manifest will be used only inside of service bundles registry apexes.
    installable: false,
    // Reduce prebuilt visibility to avoid adding it in another APEX.
    visibility: ["//visibility:private"],
}

prebuilt_etc {
    name: "com.android.sdv.sample.vsidl_vhal_proxy_integration.tire_pressure.acl_policy",
    src: "TirePressurePublisher.textproto",
    filename_from_src: true,
    installable: false,
    // Reduce prebuilt visibility to avoid adding it in another APEX.
    visibility: ["//visibility:private"],
}

prebuilt_etc {
    name: "range_remaining_sample_acl_textproto",
    filename_from_src: true,
    src: "RangeRemainingPublisher.textproto",
    sub_dir: "sdv_authz_acls/com.android.sdv.sample.vsidl_vhal_proxy_integration",
    vendor: true,
}
