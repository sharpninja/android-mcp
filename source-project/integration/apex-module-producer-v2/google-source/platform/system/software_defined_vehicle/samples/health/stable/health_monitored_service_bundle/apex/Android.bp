package {
    default_applicable_licenses: [
        "Android-Apache-2.0",
    ],
}

// Apex to store sample monitored service
apex {
    name: "com.android.sdv.sample.oem.health.monitored",
    native_shared_libs: [
        "liboem_health_monitored_sample_service_bundle",
    ],
    // Security contexts to files in the APEX.
    file_contexts: "health_monitored_service_apex_file_contexts",
    // Json manifest file describing meta info of this APEX bundle.
    // The 'name' filed from this json is used for mounting point.
    manifest: "apex_manifest.json",
    // Control whether this module compiles for 32-bit, 64-bit, or both.
    compile_multilib: "both",
    prebuilts: [
        "HealthMonitoredServiceBundleConfig",
        "com.android.sdv.sample.oem.health.monitored.manifest",
        "com.android.sdv.sample.oem.health.monitored.manifest.linker-config",
        "com.android.sdv.sample.oem.health.monitored.acl_policy",
        "SampleHMBundle-orch-config",
    ],
    // Name of the apex_key module that provides the private key to sign the APEX bundle.
    key: "com.android.sdv.samples.key",
    // Set the min sdk version.
    min_sdk_version: "35",
    // Mark apex as updatable.
    updatable: true,
    // This module is installed into /product partition.
    product_specific: true,
}

// File with the orchestration configuration of service bundle is stored in the apex.
prebuilt_etc {
    name: "SampleHMBundle-orch-config",
    src: "SampleHMBundle-orch-config.textproto",
    filename: "SampleHMBundle-orch-config.textproto",
    sub_dir: "config/orchestration",
    // The configuration will be used only inside of service bundles apexes.
    installable: false,
}

// Global VM config related to SampleHMBundle, used in HM suspend to RAM testing
prebuilt_etc {
    name: "hm_suspend_to_ram_test_vm_orch_config",
    // The source name of the configuration file.
    src: "hm_suspend_to_ram_test_global_orch_config.textproto",
    filename: "hm_suspend_to_ram_test_global_orch_config.textproto",
    // not part of an APEX, as global config should be readable by Orch independent from APEX lifetimes.
    installable: true,
    // This module is installed into /product partition.
    product_specific: true,
    sub_dir: "orch",
}

// File with the health monitor configuration of service bundle is stored in the apex.
prebuilt_etc {
    name: "HealthMonitoredServiceBundleConfig",
    // The source name of the configuration file.
    src: "health_configuration.textproto",
    filename: "health_configuration.textproto",
    // Disable direct installation to one of the partitions.
    // The configuration will be used only inside of service bundles apexes.
    installable: false,
    sub_dir: "config/",
}

// SDV manifest file with the metadata information about service bundles stored in the apex.
prebuilt_etc {
    name: "com.android.sdv.sample.oem.health.monitored.manifest",
    // The source name of the manifest file.
    src: "sdv_service_bundles_manifest.textproto",
    // The name of the installed file shall be `sdv_service_bundles_manifest.textproto`.
    filename: "sdv_service_bundles_manifest.textproto",
    // Disable direct installation of the manifest to one of the partitions.
    // The manifest will be used only inside of service bundles registry apexes.
    installable: false,
}

// The linker config to allow libraries for the apex to be linkable.
linker_config {
    name: "com.android.sdv.sample.oem.health.monitored.manifest.linker-config",
    src: "linker.config.json",
    // Disable direct installation of the linker config to one of the partitions.
    // The linker configuration will be used only inside of service bundles registry apexes.
    installable: false,
}

// File with the ACL policy of service bundle is stored in the apex.
prebuilt_etc {
    name: "com.android.sdv.sample.oem.health.monitored.acl_policy",
    // The source name of the manifest file.
    src: "acl.textproto",
    filename: "acl.textproto",
    // Disable direct installation of the manifest to one of the partitions.
    // The manifest will be used only inside of service bundles registry apexes.
    installable: false,
    // Reduce prebuilt visibility to avoid adding it in another APEX.
    visibility: ["//visibility:private"],
}
