package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

// This APEX packages the User Preferences service implementation and the
// orchestration configuration file required to launch the service.
// The service is automatically started by the `sdv_orchestrator` upon boot.
// This acts as a reference implementation for OEMs to adapt and integrate
// within their own APEXes. For the configuration APEX containing the
// ACL policy and manifest, refer to com.android.sdv.user_preferences.
apex {
    name: "com.android.sdv.sample.user_preferences",
    manifest: "apex_manifest.json",
    key: "com.android.sdv.sample.user_preferences.key",
    certificate: ":com.android.sdv.sample.user_preferences.certificate",
    file_contexts: "file_contexts",
    updatable: false,
    prebuilts: [
        // SDV Manifest - used by SBR
        "com.android.sdv.sample.user_preferences.manifest",
        // ACL Policy
        "com.android.sdv.sample.user_preferences.hvac_service.acl_policy",
        // ACL Policy
        "com.android.sdv.sample.user_preferences.user_preferences_service_bundle.acl_policy",
        // ACL Policy
        "com.android.sdv.sample.user_preferences.hmi_service.acl_policy",
        // ACL Policy
        "com.android.sdv.sample.user_preferences.car_seats_service.acl_policy",
        // Orchestration config
        "com.android.sdv.sample.user_preferences.user_preferences_service_bundle.orchestration",
        // Orchestration config
        "com.android.sdv.sample.user_preferences.hvac_service.orchestration",
        // Orchestration config
        "com.android.sdv.sample.user_preferences.hmi_service.orchestration",
        // Orchestration config
        "com.android.sdv.sample.user_preferences.car_seats_service.orchestration",
        // Linker configuration to enable loading library from apex.
        "com.android.sdv.sample.user_preferences.linker_config",
    ],
    native_shared_libs: [
        // User Preferences Implementation
        "libuser_preferences_service_stable",
        "libsdv_hvac_service",
        "libsdv_hmi_service",
        "libsdv_car_seats_service",
    ],
    product_specific: true,
}

apex_key {
    name: "com.android.sdv.sample.user_preferences.key",
    public_key: "com.android.sdv.sample.user_preferences.avbpubkey",
    private_key: "com.android.sdv.sample.user_preferences.pem",
}

android_app_certificate {
    name: "com.android.sdv.sample.user_preferences.certificate",
    certificate: "com.android.sdv.sample.user_preferences",
}

// SDV manifest file.
prebuilt_etc {
    name: "com.android.sdv.sample.user_preferences.manifest",
    // The source name of the manifest file.
    src: "sdv_service_bundles_manifest.textproto",
    // The name of the installed file shall be `sdv_service_bundles_manifest.textproto`.
    filename: "sdv_service_bundles_manifest.textproto",
    // Disable direct installation of the manifest to one of the partitions.
    // The manifest will be used only inside of service bundles registry apexes.
    installable: false,
    // Reduce prebuilt visibility to avoid adding it in another APEX.
    visibility: ["//visibility:private"],
}

// File with the ACL policy of service bundle is stored in the apex.
prebuilt_etc {
    name: "com.android.sdv.sample.user_preferences.hvac_service.acl_policy",
    // The source name of the manifest file.
    src: "acl_configs/hvac_service/acl.textproto",
    sub_dir: "hvac_service",
    filename: "acl.textproto",
    // Disable direct installation of the manifest to one of the partitions.
    // The manifest will be used only inside of service bundles registry apexes.
    installable: false,
    // Reduce prebuilt visibility to avoid adding it in another APEX.
    visibility: ["//visibility:private"],
}

// File with the ACL policy of service bundle is stored in the apex.
prebuilt_etc {
    name: "com.android.sdv.sample.user_preferences.user_preferences_service_bundle.acl_policy",
    // The source name of the manifest file.
    src: "acl_configs/user_preferences_service_bundle/acl.textproto",
    sub_dir: "user_preferences_service_bundle",
    filename: "acl.textproto",
    // Disable direct installation of the manifest to one of the partitions.
    // The manifest will be used only inside of service bundles registry apexes.
    installable: false,
    // Reduce prebuilt visibility to avoid adding it in another APEX.
    visibility: ["//visibility:private"],
}

// File with the ACL policy of service bundle is stored in the apex.
prebuilt_etc {
    name: "com.android.sdv.sample.user_preferences.hmi_service.acl_policy",
    // The source name of the manifest file.
    src: "acl_configs/hmi_service/acl.textproto",
    sub_dir: "hmi_service",
    filename: "acl.textproto",
    // Disable direct installation of the manifest to one of the partitions.
    // The manifest will be used only inside of service bundles registry apexes.
    installable: false,
    // Reduce prebuilt visibility to avoid adding it in another APEX.
    visibility: ["//visibility:private"],
}

// File with the ACL policy of service bundle is stored in the apex.
prebuilt_etc {
    name: "com.android.sdv.sample.user_preferences.car_seats_service.acl_policy",
    // The source name of the manifest file.
    src: "acl_configs/car_seats_service/acl.textproto",
    sub_dir: "car_seats_service",
    filename: "acl.textproto",
    // Disable direct installation of the manifest to one of the partitions.
    // The manifest will be used only inside of service bundles registry apexes.
    installable: false,
    // Reduce prebuilt visibility to avoid adding it in another APEX.
    visibility: ["//visibility:private"],
}

// File with the Orchestration configuration of service bundle is stored in the apex.
prebuilt_etc {
    name: "com.android.sdv.sample.user_preferences.user_preferences_service_bundle.orchestration",
    src: "orch_configs/user_preferences_service_bundle/orchestration.textproto",
    sub_dir: "user_preferences_service_bundle",
    filename: "orchestration.textproto",
    // Disable direct installation of the manifest to one of the partitions.
    // The manifest will be used only inside of service bundles registry apexes.
    installable: false,
    // Reduce prebuilt visibility to avoid adding it in another APEX.
    visibility: ["//visibility:private"],
}

// File with the Orchestration configuration of service bundle is stored in the apex.
prebuilt_etc {
    name: "com.android.sdv.sample.user_preferences.hvac_service.orchestration",
    src: "orch_configs/hvac_service/orchestration.textproto",
    sub_dir: "hvac_service",
    filename: "orchestration.textproto",
    // Disable direct installation of the manifest to one of the partitions.
    // The manifest will be used only inside of service bundles registry apexes.
    installable: false,
    // Reduce prebuilt visibility to avoid adding it in another APEX.
    visibility: ["//visibility:private"],
}

// File with the Orchestration configuration of service bundle is stored in the apex.
prebuilt_etc {
    name: "com.android.sdv.sample.user_preferences.hmi_service.orchestration",
    src: "orch_configs/hmi_service/orchestration.textproto",
    sub_dir: "hmi_service",
    filename: "orchestration.textproto",
    // Disable direct installation of the manifest to one of the partitions.
    // The manifest will be used only inside of service bundles registry apexes.
    installable: false,
    // Reduce prebuilt visibility to avoid adding it in another APEX.
    visibility: ["//visibility:private"],
}

// File with the Orchestration configuration of service bundle is stored in the apex.
prebuilt_etc {
    name: "com.android.sdv.sample.user_preferences.car_seats_service.orchestration",
    src: "orch_configs/car_seats_service/orchestration.textproto",
    sub_dir: "car_seats_service",
    filename: "orchestration.textproto",
    // Disable direct installation of the manifest to one of the partitions.
    // The manifest will be used only inside of service bundles registry apexes.
    installable: false,
    // Reduce prebuilt visibility to avoid adding it in another APEX.
    visibility: ["//visibility:private"],
}

// The linker config to allow libraries for the apex to be linkable.
linker_config {
    name: "com.android.sdv.sample.user_preferences.linker_config",
    src: "linker.config.json",
    // Disable direct installation of the prebuilt to one of the partitions.
    // The linker configuration is used only inside of an apex.
    installable: false,
}
