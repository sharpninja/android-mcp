package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

apex {
    name: "com.android.sdv.sample.orchestrator",
    key: "sample.orchestration.key",
    certificate: ":com.android.sdv.sample.orchestrator.certificate",
    manifest: "apex_manifest.json",
    file_contexts: "file_contexts",
    prebuilts: [
        "sample.orchestration.linker_config_file",
        "sample.orchestration.sdv_bundles_manifest",

        "custom_mode_sample_control_bundle.orch_conf.textproto",
        "custom_mode_sample_consumer_bundle.orch_conf.textproto",
        "com.android.sdv.sample.orchestrator.permissions",
    ],
    native_shared_libs: [
        "libcustom_mode_sample_control_bundle",
        "libcustom_mode_sample_consumer_bundle",
    ],
    updatable: false,
    product_specific: true,
    min_sdk_version: "35",
}

apex_key {
    name: "sample.orchestration.key",
    public_key: "sample.orch.avbpubkey",
    private_key: "sample.orch.pem",
}

android_app_certificate {
    name: "com.android.sdv.sample.orchestrator.certificate",
    certificate: "sample.orchestration.certificate",
}

prebuilt_etc {
    name: "custom_mode_sample_control_bundle.orch_conf.textproto",
    src: "custom_mode_sample_control_bundle.orch_conf.textproto",
    filename: "custom_mode_sample_control_bundle.orch_conf.textproto",
    installable: false,
}

prebuilt_etc {
    name: "custom_mode_sample_consumer_bundle.orch_conf.textproto",
    src: "custom_mode_sample_consumer_bundle.orch_conf.textproto",
    filename: "custom_mode_sample_consumer_bundle.orch_conf.textproto",
    installable: false,
}

// File with the Authz policy of service bundle is stored in the apex.
prebuilt_etc {
    name: "com.android.sdv.sample.orchestrator.permissions",
    src: "permissions.textproto",
    filename: "permissions.textproto",
    installable: false,
    visibility: ["//visibility:private"],
}

prebuilt_etc {
    name: "sample.orchestration.sdv_bundles_manifest",
    src: "sdv_bundles_manifest.textproto",
    // filename needs to be the one defined below. One bundle manifest per apex file, containing
    // a bundle_metadata for each bundle in the apex
    filename: "sdv_service_bundles_manifest.textproto",
    installable: false,
}

linker_config {
    name: "sample.orchestration.linker_config_file",
    src: "linker.config.json",
    installable: false,
}
