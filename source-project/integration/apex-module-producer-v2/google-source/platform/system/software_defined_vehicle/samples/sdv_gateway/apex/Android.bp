package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

apex {
    name: "com.android.sdv.samples.gateway",
    manifest: "apex_manifest.json",
    key: "com.android.sdv.samples.gateway.key",
    certificate: ":com.android.sdv.samples.gateway.certificate",
    prebuilts: [
        // SDV service bundles manifest file.
        "com.android.sdv.samples.gateway.manifest",
        // SDV Gateway sample services ACL policies.
        "com.android.sdv.samples.gateway.cluster_client.acl_policy",
        "com.android.sdv.samples.gateway.cluster_server.acl_policy",
        "com.android.sdv.samples.gateway.dt_publisher.acl_policy",
        "com.android.sdv.samples.gateway.tpms_server.acl_policy",
        "com.android.sdv.samples.gateway.sunroof_client.acl_policy",
        "com.android.sdv.samples.gateway.dt_subscriber.acl_policy",
    ],
    // The sdv_core_cf target is based on vsoc_x86_64
    compile_multilib: "64",
    product_specific: true,
    file_contexts: "file_contexts",
    updatable: false,
}

apex_key {
    name: "com.android.sdv.samples.gateway.key",
    public_key: "com.android.sdv.samples.gateway.avbpubkey",
    private_key: "com.android.sdv.samples.gateway.pem",
}

android_app_certificate {
    name: "com.android.sdv.samples.gateway.certificate",
    certificate: "com.android.sdv.samples.gateway",
}

// SDV service bundles manifest file prebuilt.
prebuilt_etc {
    name: "com.android.sdv.samples.gateway.manifest",
    // The source name of the manifest file.
    src: "sdv_service_bundles_manifest.textproto",
    // The name of the installed file shall be `sdv_service_bundles_manifest.textproto`.
    filename: "sdv_service_bundles_manifest.textproto",
    // Disable direct installation of the manifest to one of the partitions.
    // The manifest will be used only inside of service bundles registry apexes.
    installable: false,
    // Reduce prebuilt visibility to avoid adding it in another APEX.
    visibility: ["//visibility:private"],
}

// File with the ACL policy of ClusterServer service bundle is stored in the apex.
prebuilt_etc {
    name: "com.android.sdv.samples.gateway.cluster_server.acl_policy",
    // The source name of the manifest file.
    src: "cluster_server_acl.textproto",
    filename: "cluster_server_acl.textproto",
    // Disable direct installation of the manifest to one of the partitions.
    // The manifest will be used only inside of service bundles registry apexes.
    installable: false,
    // Reduce prebuilt visibility to avoid adding it in another APEX.
    visibility: ["//visibility:private"],
}

// File with the ACL policy of ClusterServer service bundle is stored in the apex.
prebuilt_etc {
    name: "com.android.sdv.samples.gateway.cluster_client.acl_policy",
    // The source name of the manifest file.
    src: "cluster_client_acl.textproto",
    filename: "cluster_client_acl.textproto",
    // Disable direct installation of the manifest to one of the partitions.
    // The manifest will be used only inside of service bundles registry apexes.
    installable: false,
    // Reduce prebuilt visibility to avoid adding it in another APEX.
    visibility: ["//visibility:private"],
}

// File with the ACL policy of Gateway Pub/Sub sample is stored in the /etc folder.
prebuilt_etc {
    name: "sdv_dt_publisher_cpp_acl_textproto",
    sub_dir: "sdv_authz_acls/android.sdv.samples.gateway",
    src: "DtPublisher.textproto",
    filename_from_src: true,
    vendor: true,
}

// File with the ACL policy of Gateway Pub/Sub sample is stored in the apex.
prebuilt_etc {
    name: "com.android.sdv.samples.gateway.dt_publisher.acl_policy",
    // The source name of the ACL file.
    src: "DtPublisher.textproto",
    filename: "DtPublisher.textproto",
    // Disable direct installation of the file to one of the partitions.
    // The file will be used only inside of service bundles registry apexes.
    installable: false,
    // Reduce prebuilt visibility to avoid adding it in another APEX.
    visibility: ["//visibility:private"],
}

// File with the ACL policy of TpmsServer service bundle is stored in the apex.
prebuilt_etc {
    name: "com.android.sdv.samples.gateway.tpms_server.acl_policy",
    // The source name of the manifest file.
    src: "tpms_server_acl.textproto",
    filename: "tpms_server_acl.textproto",
    // Disable direct installation of the manifest to one of the partitions.
    // The manifest will be used only inside of service bundles registry apexes.
    installable: false,
    // Reduce prebuilt visibility to avoid adding it in another APEX.
    visibility: ["//visibility:private"],
}

prebuilt_etc {
    name: "com.android.sdv.samples.gateway.sunroof_client.acl_policy",
    src: "sunroof_client_acl.textproto",
    filename: "sunroof_client_acl.textproto",
    installable: false,
    visibility: ["//visibility:private"],
}

prebuilt_etc {
    name: "com.android.sdv.samples.gateway.dt_subscriber.acl_policy",
    src: "DtSubscriber.textproto",
    filename: "DtSubscriber.textproto",
    installable: false,
    visibility: ["//visibility:private"],
}
