package {
    default_applicable_licenses: [
        "Android-Apache-2.0",
    ],
}

// V1 target of the APEX, included in image
apex {
    name: "com.android.sdv.sample.test1",
    native_shared_libs: [
        "libsdv_apex_discovery_hello_world",
    ],
    manifest: "v1/apex_manifest.json",
    compile_multilib: "both",
    product_specific: true,
    file_contexts: "file_contexts",
    prebuilts: [
        "com.android.sdv.sample.test1.manifest",
        "com.android.sdv.sample.test1.linker-config",
    ],
    key: "com.android.sdv.samples.key",
    updatable: false,
}

// V2 target of the APEX, excluded in image but distributed to CI
apex {
    name: "com.android.sdv.sample.test1.v2",
    native_shared_libs: [
        "libsdv_apex_discovery_hello_world_v2",
    ],
    manifest: "v2/apex_manifest.json",
    compile_multilib: "both",
    product_specific: true,
    file_contexts: "file_contexts",
    prebuilts: [
        "com.android.sdv.sample.test1.manifest.v2",
        "com.android.sdv.sample.test1.linker-config",
    ],
    key: "com.android.sdv.samples.key",
    updatable: false,
}

// V1 of manifest file holding the service bundle metadata.
prebuilt_etc {
    name: "com.android.sdv.sample.test1.manifest",
    src: "v1/sdv_service_bundles_manifest.textproto",
    filename: "sdv_service_bundles_manifest.textproto",
    installable: false,
}

// V2 of manifest file holding the service bundle metadata.
prebuilt_etc {
    name: "com.android.sdv.sample.test1.manifest.v2",
    src: "v2/sdv_service_bundles_manifest.textproto",
    filename: "sdv_service_bundles_manifest.textproto",
    installable: false,
}

// The linker config to allow libraries in the APEX to be linkable.
linker_config {
    name: "com.android.sdv.sample.test1.linker-config",
    src: "linker.config.json",
    installable: false,
}

// Sample of the hello world service bundle to demonstrate APEX discovery.
rust_ffi_shared {
    name: "libsdv_apex_discovery_hello_world",
    srcs: ["v1/srcs/lib.rs"],
    crate_name: "sdv_apex_discovery_hello_world",
    defaults: [
        "sdv@rust_defaults",
    ],
    rustlibs: [
        "libsdv_lifecycle_client_rust",
        "liblog_rust",
        "libsdv_comms_rs",
    ],
    apex_available: [
        "com.android.sdv.sample.test1",
    ],
    product_specific: true,
}

// Sample of the new versiion of hello world service bundle to demonstrate APEX update.
rust_ffi_shared {
    name: "libsdv_apex_discovery_hello_world_v2",
    srcs: ["v2/srcs/lib.rs"],
    crate_name: "sdv_apex_discovery_hello_world_v2",
    defaults: [
        "sdv@rust_defaults",
    ],
    rustlibs: [
        "libsdv_lifecycle_client_rust",
        "liblog_rust",
        "libsdv_comms_rs",
    ],
    apex_available: [
        "com.android.sdv.sample.test1.v2",
    ],
    product_specific: true,
}
