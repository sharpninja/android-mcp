package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

apex {
    name: "com.android.sdv.sample.oem.diagnostics",
    manifest: "apex_manifest.json",
    key: "com.android.sdv.sample.oem.diagnostics.key",
    certificate: ":com.android.sdv.sample.oem.diagnostics.certificate",
    file_contexts: "file_contexts",
    native_shared_libs: [
        "liboem_diagnostics_sample_with_data_item",
        "liboem_diagnostics_sample_with_event",
        "libdiag_v1_provider1_sample",
        "libdiag_v1_provider2_sample",
    ],
    prebuilts: [
        // SDV Manifest - used by SBR
        "com.android.sdv.sample.oem.diagnostics.manifest",
        // Orchestration config
        "com.android.sdv.sample.oem.diagnostics.data_item.orchestration",
        // Orchestration config
        "com.android.sdv.sample.oem.diagnostics.event.orchestration",
        // Start: VSIDL provider precompiled files
        "com.android.sdv.sample.oem.diagnostics.DiagnosticsSampleWithDataItem-vsidl-config.binpb",
        "com.android.sdv.sample.oem.diagnostics.DiagnosticsSampleWithEvent-vsidl-config.binpb",
        "com.android.sdv.sample.oem.diagnostics.DiagnosticsProvider1-vsidl-config.binpb",
        "com.android.sdv.sample.oem.diagnostics.DiagnosticsSampleWithDataItem-diag-config.binpb",
        "com.android.sdv.sample.oem.diagnostics.DiagnosticsSampleWithEvent-diag-config.binpb",
        "com.android.sdv.sample.oem.diagnostics.DiagnosticsProvider1-diag-config.binpb",
        // End: VSIDL provider precompiled files
        // Linker configuration to enable loading library from apex.
        "com.android.sdv.sample.oem.diagnostics.linker_config",
        // Orchestration config
        "com.android.sdv.sample.oem.diagnostics.provider1.orchestration",
        // Permissions
        "com.android.sdv.sample.oem.diagnostics.DiagnosticsProvider1.permissions.config",
        "com.android.sdv.sample.oem.diagnostics.DiagnosticsProvider2.permissions.config",
        "com.android.sdv.sample.oem.diagnostics.DiagnosticsSampleWithDataItem.permissions.config",
        "com.android.sdv.sample.oem.diagnostics.DiagnosticsSampleWithEvent.permissions.config",
        "com.android.sdv.sample.oem.diagnostics.DiagnosticsSampleWithEcuReset.permissions.config",
        "com.android.sdv.sample.oem.diagnostics.DiagnosticsSampleWithAuthentication.permissions.config",
        "com.android.sdv.sample.oem.diagnostics.DiagnosticsSampleWithSecurityAccess.permissions.config",
        "com.android.sdv.sample.oem.diagnostics.DiagnosticsSampleWithFileTransfer.permissions.config",
        "com.android.sdv.sample.oem.diagnostics.SampleBundle.permissions.config",
    ],
    product_specific: true,
    min_sdk_version: "35",
    updatable: true,
}

apex_key {
    name: "com.android.sdv.sample.oem.diagnostics.key",
    public_key: "com.android.sdv.sample.oem.diagnostics.avbpubkey",
    private_key: "com.android.sdv.sample.oem.diagnostics.pem",
}

android_app_certificate {
    name: "com.android.sdv.sample.oem.diagnostics.certificate",
    certificate: "com.android.sdv.sample.oem.diagnostics",
}

// SDV manifest file.
prebuilt_etc {
    name: "com.android.sdv.sample.oem.diagnostics.manifest",
    // The source name of the manifest file.
    src: "sdv_service_bundles_manifest.textproto",
    // The name of the installed file shall be `sdv_service_bundles_manifest.textproto`.
    filename: "sdv_service_bundles_manifest.textproto",
    // Disable direct installation of the manifest to one of the partitions.
    // The manifest will be used only inside of service bundles registry apexes.
    installable: false,
    // Reduce prebuilt visibility to avoid adding it in another APEX.
    visibility: ["//visibility:private"],
}

// File with the Orchestration configuration of service bundle is stored in the apex.
prebuilt_etc {
    name: "com.android.sdv.sample.oem.diagnostics.provider1.orchestration",
    src: "configuration/provider1/orchestration.textproto",
    sub_dir: "provider1",
    filename: "orchestration.textproto",
    // Disable direct installation of the manifest to one of the partitions.
    // The manifest will be used only inside of service bundles registry apexes.
    installable: false,
    // Reduce prebuilt visibility to avoid adding it in another APEX.
    visibility: ["//visibility:private"],
}

// File with the Orchestration configuration of service bundle is stored in the apex.
prebuilt_etc {
    name: "com.android.sdv.sample.oem.diagnostics.data_item.orchestration",
    src: "configuration/bundle_with_data_item/orchestration.textproto",
    sub_dir: "data_item",
    filename: "orchestration.textproto",
    // Disable direct installation of the manifest to one of the partitions.
    // The manifest will be used only inside of service bundles registry apexes.
    installable: false,
    // Reduce prebuilt visibility to avoid adding it in another APEX.
    visibility: ["//visibility:private"],
}

// File with the Orchestration configuration of service bundle is stored in the apex.
prebuilt_etc {
    name: "com.android.sdv.sample.oem.diagnostics.event.orchestration",
    src: "configuration/bundle_with_event/orchestration.textproto",
    sub_dir: "event",
    filename: "orchestration.textproto",
    // Disable direct installation of the manifest to one of the partitions.
    // The manifest will be used only inside of service bundles registry apexes.
    installable: false,
    // Reduce prebuilt visibility to avoid adding it in another APEX.
    visibility: ["//visibility:private"],
}

// The linker config to allow libraries for the apex to be linkable.
linker_config {
    name: "com.android.sdv.sample.oem.diagnostics.linker_config",
    src: "linker.config.json",
    // Disable direct installation of the prebuilt to one of the partitions.
    // The linker configuration is used only inside of an apex.
    installable: false,
}
