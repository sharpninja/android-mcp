package {
    default_applicable_licenses: [
        "Android-Apache-2.0",
    ],
}

// V1 target of the APEX, included in image
apex {
    name: "com.android.sdv.sample.apex.provider",
    native_shared_libs: [
        "libsdv_apex_update_provider_service_bundle",
    ],
    manifest: "v1/apex_manifest.json",
    compile_multilib: "both",
    product_specific: true,
    file_contexts: "file_contexts",
    prebuilts: [
        "com.android.sdv.sample.apex.provider.manifest",
        "com.android.sdv.sample.apex.provider.linker-config",
        "com.android.sdv.sample.apex.provider.orch.config",
        "com.android.sdv.sample.apex.provider.acl_policy",
        "com.android.sdv.sample.apex.provider.Provider-vsidl-config.binpb",
    ],
    key: "com.android.sdv.samples.key",
    updatable: true,
    min_sdk_version: "35",
}

// V2 target of the APEX, excluded in image but distributed to CI
apex {
    name: "com.android.sdv.sample.apex.provider.v2",
    native_shared_libs: [
        "libsdv_apex_update_provider_service_bundle_v2",
    ],
    manifest: "v2/apex_manifest.json",
    compile_multilib: "both",
    product_specific: true,
    file_contexts: "file_contexts",
    prebuilts: [
        "com.android.sdv.sample.apex.provider.manifest.v2",
        "com.android.sdv.sample.apex.provider.linker-config",
        "com.android.sdv.sample.apex.provider.orch.config.v2",
        "com.android.sdv.sample.apex.provider.acl_policy",
        "com.android.sdv.sample.apex.provider.Provider-vsidl-config.binpb_v2",
    ],
    key: "com.android.sdv.samples.key",
    updatable: false,
}

// V1 of manifest file holding the service bundle metadata.
prebuilt_etc {
    name: "com.android.sdv.sample.apex.provider.manifest",
    src: "v1/sdv_service_bundles_manifest.textproto",
    filename: "sdv_service_bundles_manifest.textproto",
    installable: false,
}

// V1 orch config
prebuilt_etc {
    name: "com.android.sdv.sample.apex.provider.orch.config",
    // The source name of the manifest file.
    src: "v1/orch_config_v1.textproto",
    filename: "orch_config_v1.textproto",
    sub_dir: "config/orchestration",
    // Disable direct installation of the manifest to one of the partitions.
    // The manifest will be used only inside of service bundles registry apexes.
    installable: false,
}

// V2 of manifest file holding the service bundle metadata.
prebuilt_etc {
    name: "com.android.sdv.sample.apex.provider.manifest.v2",
    src: "v2/sdv_service_bundles_manifest.textproto",
    filename: "sdv_service_bundles_manifest.textproto",
    installable: false,
}

// V2 orch config
prebuilt_etc {
    name: "com.android.sdv.sample.apex.provider.orch.config.v2",
    // The source name of the manifest file.
    src: "v2/orch_config_v2.textproto",
    filename: "orch_config_v2.textproto",
    sub_dir: "config/orchestration",
    // Disable direct installation of the manifest to one of the partitions.
    // The manifest will be used only inside of service bundles registry apexes.
    installable: false,
}

// File with the ACL policy of service bundle is stored in the apex.
prebuilt_etc {
    name: "com.android.sdv.sample.apex.provider.acl_policy",
    // The source name of the manifest file.
    src: "acl.textproto",
    filename: "acl.textproto",
    // Disable direct installation of the manifest to one of the partitions.
    // The manifest will be used only inside of service bundles registry apexes.
    installable: false,
    // Reduce prebuilt visibility to avoid adding it in another APEX.
    visibility: ["//visibility:private"],
}

// The linker config to allow libraries in the APEX to be linkable.
linker_config {
    name: "com.android.sdv.sample.apex.provider.linker-config",
    src: "linker.config.json",
    installable: false,
}
