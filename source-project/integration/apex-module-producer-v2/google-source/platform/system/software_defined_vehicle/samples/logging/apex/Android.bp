package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

apex {
    name: "com.android.sdv.sample.logging",
    binaries: [
        "compile_time_log_filtering_sdv_rust_sample",
        "compile_time_log_filtering_sdv_sample",
        "log_filtering_sdv_sample",
        "logging_sdv_rust_sample",
        "logging_sdv_sample",
        "structured_logging_sdv_sample",
        // TODO: b/361610453 - include this in the APEX when possible.
        //
        // Rust bindings to log_event_list are not apex_available at this
        // point. This doesn't cause issues for an SDV build, because
        // apex_availability is generally not enforced in product_specific
        // code. However, there's one postsubmit check that enforces strict
        // apex_availability and fails when we try to submit this.
        //"structured_logging_sdv_rust_sample",
    ],
    native_shared_libs: [
        "libsdv_logging_sample_service_bundle",
        "libsdv_logging_sample_service_bundle_with_custom_tag",
        "sdv_logging_sample_service_bundle_cpp",
        "sdv_logging_sample_service_bundle_with_custom_tag_cpp",
    ],
    prebuilts: [
        "libsdv_logging_sample_service_bundle_linker_config",
        "libsdv_logging_sample_service_bundle_manifest",
    ],
    manifest: "apex_manifest.json",
    compile_multilib: "both",
    product_specific: true,
    updatable: true,
    min_sdk_version: "35",
    file_contexts: "file_contexts",
    key: "com.android.sdv.samples.key",
}

prebuilt_etc {
    name: "libsdv_logging_sample_service_bundle_manifest",
    src: "sdv_service_bundles_manifest.textproto",
    filename: "sdv_service_bundles_manifest.textproto",
    installable: false,
}

// The linker config to allow libraries in the APEX to be linkable.
linker_config {
    name: "libsdv_logging_sample_service_bundle_linker_config",
    src: "linker.config.json",
    installable: false,
}
