package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

apex {
    name: "com.android.sdv.sample.oem.concal",
    // The ConCal service bundle to be included in the apex.
    native_shared_libs: [
        "libconcal_service_bundle_runner",
        "libsdv_concal_sample_client",
    ],
    prebuilts: [
        // SDV service bundles manifest file.
        "com.android.sdv.sample.oem.concal.service_bundles_manifest",
        // Linker configuration to enable loading library from apex.
        "com.android.sdv.sample.oem.concal.linker_config",
        // Permissions
        "com.android.sdv.sample.oem.concal.client_permissions",
        "com.android.sdv.sample.oem.concal.server_permissions",
        // Orchestration config
        "com.android.sdv.sample.oem.concal.sample_oem_concal_client_service_bundle.orchestration",
        // Orchestration config
        "com.android.sdv.sample.oem.concal.sample_oem_concal_service_bundle.orchestration",
    ],
    // Json manifest file describes metadata of the APEX package.
    // The 'name' filed from the json is used as mounting point.
    manifest: "apex_manifest.json",
    // Setting the security contexts to files in this APEX bundle.
    file_contexts: "apex_file_contexts",
    // Name of the apex_key module that provides the private key to sign the APEX bundle.
    key: "com.android.sdv.samples.key",
    // Service bundle package is installed into /product partition.
    product_specific: true,
    // Set the min sdk version.
    min_sdk_version: "35",
    // Mark apex as updatable.
    updatable: true,
}

// SDV manifest file prebuilt.
prebuilt_etc {
    name: "com.android.sdv.sample.oem.concal.service_bundles_manifest",
    // The source filename of the manifest file.
    src: "sdv_service_bundles_manifest.textproto",
    // The name of the installed file needs be `sdv_service_bundles_manifest.textproto`.
    filename: "sdv_service_bundles_manifest.textproto",
    // Disable direct installation of the prebuilt to one of the partitions.
    // The manifest is used only inside of an apex.
    installable: false,
}

// The linker config to allow libraries for the apex to be linkable.
linker_config {
    name: "com.android.sdv.sample.oem.concal.linker_config",
    src: "linker.config.json",
    // Disable direct installation of the prebuilt to one of the partitions.
    // The linker configuration is used only inside of an apex.
    installable: false,
}

// File with the Orchestration configuration of service bundle is stored in the apex.
prebuilt_etc {
    name: "com.android.sdv.sample.oem.concal.sample_oem_concal_client_service_bundle.orchestration",
    src: "orch_configs/sample_oem_concal_client_service_bundle/orchestration.textproto",
    sub_dir: "sample_oem_concal_client_service_bundle",
    filename: "orchestration.textproto",
    // Disable direct installation of the manifest to one of the partitions.
    // The manifest will be used only inside of service bundles registry apexes.
    installable: false,
    // Reduce prebuilt visibility to avoid adding it in another APEX.
    visibility: ["//visibility:private"],
}

// File with the Orchestration configuration of service bundle is stored in the apex.
prebuilt_etc {
    name: "com.android.sdv.sample.oem.concal.sample_oem_concal_service_bundle.orchestration",
    src: "orch_configs/sample_oem_concal_service_bundle/orchestration.textproto",
    sub_dir: "sample_oem_concal_service_bundle",
    filename: "orchestration.textproto",
    // Disable direct installation of the manifest to one of the partitions.
    // The manifest will be used only inside of service bundles registry apexes.
    installable: false,
    // Reduce prebuilt visibility to avoid adding it in another APEX.
    visibility: ["//visibility:private"],
}

// File with the Permissions policy of service bundle is stored in the apex.
prebuilt_etc {
    name: "com.android.sdv.sample.oem.concal.server_permissions",
    // The source name of the manifest file.
    src: "server_permissions.textproto",
    filename: "server_permissions.textproto",
    // Disable direct installation of the manifest to one of the partitions.
    // The manifest will be used only inside of service bundles registry apexes.
    installable: false,
    // Reduce prebuilt visibility to avoid adding it in another APEX.
    visibility: ["//visibility:private"],
}

// File with the Permissions policy of service bundle is stored in the apex.
prebuilt_etc {
    name: "com.android.sdv.sample.oem.concal.client_permissions",
    // The source name of the manifest file.
    src: "client_permissions.textproto",
    filename: "client_permissions.textproto",
    // Disable direct installation of the manifest to one of the partitions.
    // The manifest will be used only inside of service bundles registry apexes.
    installable: false,
    // Reduce prebuilt visibility to avoid adding it in another APEX.
    visibility: ["//visibility:private"],
}
