package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

apex {
    name: "com.android.sdv.samples",
    defaults: ["sample_sdv_comms_apex@defaults"],
    prebuilts: [
        // SDV service bundles manifest file.
        "com.android.sdv.samples.service_bundles_manifest",
        // ACLs policy file.
        "com.android.sdv.samples.sdv_comms.acls.config",
        "com.android.sdv.samples.rochambeau_player.permissions",
        "com.android.sdv.samples.rochambeau_judge.permissions",
    ],
}

// SDV manifest file with the metadata information about service bundles stored in the apex.
prebuilt_etc {
    name: "com.android.sdv.samples.service_bundles_manifest",
    // The source name of the manifest file.
    src: "sdv_service_bundles_manifest.textproto",
    // The name of the installed file shall be `sdv_service_bundles_manifest.textproto`.
    filename: "sdv_service_bundles_manifest.textproto",
    // Disable direct installation of the manifest to one of the partitions.
    // The manifest will be used only inside of service bundles registry apexes.
    installable: false,
}

// Permissions for RochambeauPlayer service bundle.
prebuilt_etc {
    name: "com.android.sdv.samples.rochambeau_player.permissions",
    sub_dir: "permissions",
    src: "permissions/rochambeau_player.textproto",
    filename: "rochambeau_player.textproto",
    installable: false,
}

// Permissions for RochambeauJudge service bundle.
prebuilt_etc {
    name: "com.android.sdv.samples.rochambeau_judge.permissions",
    sub_dir: "permissions",
    src: "permissions/rochambeau_judge.textproto",
    filename: "rochambeau_judge.textproto",
    installable: false,
}
