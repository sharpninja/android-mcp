package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

// This APEX contains the ACL policy and manifest for the User Preferences service.
// It does *not* contain the User Preferences service implementation itself.  The implementation
// is expected to be provided by OEMs, typically packaged within their own APEX.
// Therefore the reference implementation is packaged within the com.android.sdv.sample.user_preferences APEX
// defined within /samples/user_preferences/v1/user_preferences/apex/Android.bp.
apex {
    name: "com.android.sdv.user_preferences",
    manifest: "apex_manifest.json",
    key: "com.android.sdv.user_preferences.key",
    certificate: ":com.android.sdv.user_preferences.certificate",
    file_contexts: "file_contexts",
    prebuilts: [
        // SDV Manifest - used by SBR
        "com.android.sdv.user_preferences.manifest",
        // Authz Policy
        "com.android.sdv.user_preferences.UserPreferencesServiceBundle.permissions",
        "com.android.sdv.user_preferences.UserPreferencesAdminServiceClient.permissions",
    ],
    product_specific: true,
    min_sdk_version: "35",
    updatable: true,
}

apex_key {
    name: "com.android.sdv.user_preferences.key",
    public_key: "com.android.sdv.user_preferences.avbpubkey",
    private_key: "com.android.sdv.user_preferences.pem",
}

android_app_certificate {
    name: "com.android.sdv.user_preferences.certificate",
    certificate: "com.android.sdv.user_preferences",
}

// SDV manifest file.
prebuilt_etc {
    name: "com.android.sdv.user_preferences.manifest",
    // The source name of the manifest file.
    src: "sdv_service_bundles_manifest.textproto",
    // The name of the installed file shall be `sdv_service_bundles_manifest.textproto`.
    filename: "sdv_service_bundles_manifest.textproto",
    // Disable direct installation of the manifest to one of the partitions.
    // The manifest will be used only inside of service bundles registry apexes.
    installable: false,
    // Reduce prebuilt visibility to avoid adding it in another APEX.
    visibility: ["//visibility:private"],
}

// File with the Authz policy of service bundle is stored in the apex.
prebuilt_etc {
    name: "com.android.sdv.user_preferences.UserPreferencesServiceBundle.permissions",
    // The source name of the manifest file.
    src: "permissions/UserPreferencesServiceBundle.textproto",
    filename: "UserPreferencesServiceBundle.textproto",
    sub_dir: "permissions",
    // Disable direct installation of the manifest to one of the partitions.
    // The manifest will be used only inside of service bundles registry apexes.
    installable: false,
    // Reduce prebuilt visibility to avoid adding it in another APEX.
    visibility: ["//visibility:private"],
}

// File with the Authz policy of service bundle is stored in the apex.
prebuilt_etc {
    name: "com.android.sdv.user_preferences.UserPreferencesAdminServiceClient.permissions",
    // The source name of the manifest file.
    src: "permissions/UserPreferencesAdminServiceClient.textproto",
    filename: "UserPreferencesAdminServiceClient.textproto",
    sub_dir: "permissions",
    // Disable direct installation of the manifest to one of the partitions.
    // The manifest will be used only inside of service bundles registry apexes.
    installable: false,
    // Reduce prebuilt visibility to avoid adding it in another APEX.
    visibility: ["//visibility:private"],
}
