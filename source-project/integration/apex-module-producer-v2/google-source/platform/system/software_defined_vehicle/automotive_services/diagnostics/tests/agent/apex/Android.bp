package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

apex {
    name: "com.sdv.oem.diagnostics",
    key: "com.android.sdv.samples.key",
    file_contexts: "file_contexts",
    prebuilts: [
        // SDV Manifest - used by SBR
        "com.sdv.oem.diagnostics.manifest",
        // ACL Policy
        "com.sdv.oem.diagnostics.permissions",
    ],
    product_specific: true,
    min_sdk_version: "37",
    updatable: true,
}

// SDV manifest file.
prebuilt_etc {
    name: "com.sdv.oem.diagnostics.manifest",
    src: "sdv_service_bundles_manifest.textproto",
    filename: "sdv_service_bundles_manifest.textproto",
    installable: false,
    visibility: ["//visibility:private"],
}

// Permissions for test Diagnostics agent
prebuilt_etc {
    name: "com.sdv.oem.diagnostics.permissions",
    src: "permissions.textproto",
    filename: "permissions.textproto",
    installable: false,
    visibility: ["//visibility:private"],
}
