package {
    default_applicable_licenses: [
        "Android-Apache-2.0",
    ],
}

// Apex to store C++ and Rust orch samples.
apex {
    name: "com.android.sdv.test.orchestrator",
    native_shared_libs: [
        // C++ service bundle to be included in the apex.
        "liboem_orchestrator_service_bundle_cpp_sample",
        // Rust service bundle to be included in the apex.
        "liboem_orchestrator_service_bundle_rust_sample",
    ],
    // Security contexts to files in the APEX.
    file_contexts: "orch_sample_apex_file_contexts",
    // Json manifest file describing meta info of this APEX bundle.
    // The 'name' filed from this json is used for mounting point.
    manifest: "apex_manifest.json",
    prebuilts: [
        // SDV service bundles manifest file.
        "com.android.sdv.test.orchestrator.manifest",
        // Linker configuration to enable loading library from apex.
        "com.sdv.google.sample.orch.linker-config",
        // Orchestration configurations.
        "OrchestratorSampleRustServiceBundle-orch-config",
        "OrchestratorSampleCppServiceBundle-orch-config",
        "OrchestratorSampleCppServiceBundle-permissions-config",
        "OrchSampleInitialPowerState-orch-config",
        "OrchTestServiceBundle-permissions-config",
    ],
    // Name of the apex_key module that provides the private key to sign the APEX bundle.
    key: "com.android.sdv.test.orchestrator_key",
    // TODO(b/333868045): make it updatable when all SDV dependencies are ready.
    updatable: false,
    // This module is installed into /product partition.
    product_specific: true,
}

// The key for signing orch sample apex.
apex_key {
    name: "com.android.sdv.test.orchestrator_key",
    public_key: "com.android.sdv.test.orchestrator.avbpubkey",
    private_key: "com.android.sdv.test.orchestrator.pem",
}

// SDV manifest file with the metadata information about service bundles stored in the apex.
prebuilt_etc {
    name: "com.android.sdv.test.orchestrator.manifest",
    // The source name of the manifest file.
    src: "sdv_service_bundles_manifest.textproto",
    // The name of the installed file shall be `sdv_service_bundles_manifest.textproto`.
    filename: "sdv_service_bundles_manifest.textproto",
    // Disable direct installation of the manifest to one of the partitions.
    // The manifest will be used only inside of service bundles registry apexes.
    installable: false,
}

// File with the orchestration configuration of service bundle is stored in the apex.
prebuilt_etc {
    name: "OrchestratorSampleRustServiceBundle-orch-config",
    // The source name of the manifest file.
    src: "OrchestratorSampleRustServiceBundle.textproto",
    filename: "OrchestratorSampleRustServiceBundle.textproto",
    sub_dir: "config/orchestration",
    // Disable direct installation of the manifest to one of the partitions.
    // The manifest will be used only inside of service bundles registry apexes.
    installable: false,
}

// File with the orchestration configuration of service bundle is stored in the apex.
prebuilt_etc {
    name: "OrchSampleInitialPowerState-orch-config",
    // The source name of the manifest file.
    src: "OrchSampleInitialPowerState.textproto",
    filename: "OrchSampleInitialPowerState.textproto",
    sub_dir: "config/orchestration",
    // Disable direct installation of the manifest to one of the partitions.
    // The manifest will be used only inside of service bundles registry apexes.
    installable: false,
}

// File with the orchestration configuration of service bundle is stored in the apex.
prebuilt_etc {
    name: "OrchestratorSampleCppServiceBundle-orch-config",
    // The source name of the manifest file.
    src: "OrchestratorSampleCppServiceBundle.textproto",
    filename: "OrchestratorSampleCppServiceBundle.textproto",
    sub_dir: "config/orchestration",
    // Disable direct installation of the manifest to one of the partitions.
    // The manifest will be used only inside of service bundles registry apexes.
    installable: false,
}

// File with the permissions configuration of service bundle is stored in the apex.
prebuilt_etc {
    name: "OrchestratorSampleCppServiceBundle-permissions-config",
    // The source name of the manifest file.
    src: "permissions/OrchestratorSampleCppServiceBundle.textproto",
    filename: "OrchestratorSampleCppServiceBundle.textproto",
    sub_dir: "config/permissions",
    // Disable direct installation of the manifest to one of the partitions.
    // The manifest will be used only inside of service bundles registry apexes.
    installable: false,
}

// File with the permissions configuration of service bundle is stored in the apex.
prebuilt_etc {
    name: "OrchTestServiceBundle-permissions-config",
    // The source name of the manifest file.
    src: "permissions/OrchTestServiceBundle.textproto",
    filename: "OrchTestServiceBundle.textproto",
    sub_dir: "config/permissions",
    // Disable direct installation of the manifest to one of the partitions.
    // The manifest will be used only inside of service bundles registry apexes.
    installable: false,
}

// The linker config to allow libraries for the apex to be linkable.
linker_config {
    name: "com.sdv.google.sample.orch.linker-config",
    src: "linker.config.json",
    // Disable direct installation of the linker config to one of the partitions.
    // The linker configuration will be used only inside of service bundles registry apexes.
    installable: false,
}
